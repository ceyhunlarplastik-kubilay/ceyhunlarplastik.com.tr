  createdByUserId String
  createdByUser   User   @relation("CustomerAssignedProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productVariantId, source])
  @@index([customerId, source, displayOrder])
  @@index([productVariantId])
  @@index([createdByUserId])
