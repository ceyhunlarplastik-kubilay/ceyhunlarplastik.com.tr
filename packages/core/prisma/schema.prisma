/// Portalda "Favori Ürün Varyantlarım" olarak gösterilir. İki kaynaktan beslenir:
/// temsilci/admin ataması (STAFF) ve müşterinin kendi kalp işareti (CUSTOMER).
/// Aynı varyant iki kaynakta da bulunabilir; bu yüzden tekillik kısıtı `source`
/// içerir ve toplu yazma yolu (replaceAssignedProducts) YALNIZ STAFF satırlarına
/// dokunur — aksi hâlde temsilci kaydı müşterinin favorilerini silerdi.
enum CustomerAssignedProductSource {
  STAFF
  CUSTOMER
}

model CustomerAssignedProduct {
