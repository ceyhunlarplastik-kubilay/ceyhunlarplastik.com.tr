// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

///////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////

model User {
  id                              String                        @id @default(uuid())
  cognitoSub                      String                        @unique
  email                           String                        @unique
  identifier                      String
  firstName                       String?
  lastName                        String?
  imageKey                        String?
  phone                           String?
  groups                          String[]
  accessStatus                    UserAccessStatus              @default(PENDING_REVIEW)
  accessStatusChangedAt           DateTime?
  accessStatusChangedByUserId     String?
  accessStatusReason              String?                       @db.Text
  supplierId                      String?
  supplier                        Supplier?                     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customerId                      String?
  customer                        Customer?                     @relation("CustomerPortalUsers", fields: [customerId], references: [id], onDelete: SetNull)
  customerContactTitle            String?
  customerContactDepartment       String?
  isPrimaryCustomerContact        Boolean                       @default(false)
  isActive                        Boolean                       @default(true)
  assignedSalesCustomers          Customer[]                    @relation("AssignedSalesUser")
  convertedCustomers              Customer[]                    @relation("CustomerConvertedBy")
  assignedPurchasingSuppliers     Supplier[]                    @relation("SupplierPurchasingAssignments")
  requestedBusinessRequests       BusinessRequest[]             @relation("BusinessRequestRequestedBy")
  requestedOrders                 Order[]                       @relation("CustomerOrderRequestedBy")
  assignedBusinessRequestSteps    BusinessRequestApprovalStep[] @relation("BusinessRequestStepAssignedUser")
  decidedBusinessRequestSteps     BusinessRequestApprovalStep[] @relation("BusinessRequestStepDecidedBy")
  activityLogs                    ActivityLog[]                 @relation("ActivityLogActor")
  createdCustomerAssignedProducts CustomerAssignedProduct[]     @relation("CustomerAssignedProductCreatedBy")
  createdProductVariantCampaigns  ProductVariantCampaign[]      @relation("ProductVariantCampaignCreatedBy")
  createdCampaignAnnouncements    CampaignAnnouncement[]        @relation("CampaignAnnouncementCreatedBy")
  ownedCustomerVisits             CustomerVisit[]               @relation("CustomerVisitOwner")
  createdCustomerVisits           CustomerVisit[]               @relation("CustomerVisitCreatedBy")
  createdCustomerSpecialPrices    CustomerVariantSpecialPrice[] @relation("CustomerVariantSpecialPriceCreatedBy")
  approvedCustomerSpecialPrices   CustomerVariantSpecialPrice[] @relation("CustomerVariantSpecialPriceApprovedBy")
  notifications                   UserNotification[]
  verifiedCustomerAddresses       CustomerAddress[]             @relation("CustomerAddressVerifiedByUser")
  customerInvitations             UserInvitation[]              @relation("CustomerPortalInvitationUser")
  sentCustomerInvitations         UserInvitation[]              @relation("CustomerPortalInvitationInvitedByUser")
  createdMachineDowntimes         MachineDowntime[]             @relation("MachineDowntimeCreatedBy")
  createdProductionOrders         ProductionOrder[]             @relation("ProductionOrderCreatedBy")
  createdProductionJobs           ProductionJob[]               @relation("ProductionJobCreatedBy")
  productionLotNotes              ProductionLotNote[]           @relation("ProductionLotNoteAuthor")
  reportedProductionLots          ProductionLot[]               @relation("ProductionLotReportedBy")
  createdProductionStops          ProductionStop[]              @relation("ProductionStopCreatedBy")
  productionJobStatusChanges      ProductionJobStatusChange[]   @relation("ProductionJobStatusChangeUser")
  auditLogs                       AuditLog[]                    @relation("AuditLogActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, isPrimaryCustomerContact])
  @@index([accessStatus, createdAt])
}

enum UserAccessStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

model UserNotification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserNotificationType
  title     String
  message   String               @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
}

enum UserNotificationType {
  ACCESS_STATUS_CHANGED
  ROLE_CHANGED
  ASSIGNMENT_CHANGED
  REQUEST_CREATED
  APPROVAL_REQUIRED
  REQUEST_DECIDED
  /// Üretim uyarısı (4.5): gecikme, termin riski, kalıp bakımı — alt tür `data.kind`'da
  /// (yeni uyarı türü migration istemesin). Tekrar önleme anahtarı `data.alertKey`.
  PRODUCTION_ALERT
}

///////////////////////////////////////////////////////
// COLOR
///////////////////////////////////////////////////////

model Color {
  id       String      @id @default(uuid())
  system   ColorSystem @default(RAL)
  code     String
  name     String
  hex      String
  rgbR     Int?
  rgbG     Int?
  rgbB     Int?
  isActive Boolean     @default(true)

  // Renk varyanta doğrudan değil, ürün modeli başına tutulan versiyon kaydına
  // (renk + hammadde kombinasyonu = "V1") bağlanır.
  versions     VariantVersion[]
  translations ColorTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([system, code])
}

model ColorTranslation {
  id      String @id @default(uuid())
  colorId String
  locale  String @db.VarChar(16)
  name    String

  color Color @relation(fields: [colorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colorId, locale])
  @@index([locale, colorId])
}

enum ColorSystem {
  RAL
  PANTONE
  NCS
  CUSTOM
}

///////////////////////////////////////////////////////
// CATEGORY
///////////////////////////////////////////////////////

model Category {
  id                       String   @id @default(uuid())
  code                     Int
  name                     String
  slug                     String   @unique
  allowedAttributeValueIds String[] @default([])

  products     Product[]
  assets       Asset[]
  translations CategoryTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
}

model CategoryTranslation {
  id         String @id @default(uuid())
  categoryId String
  locale     String @db.VarChar(16)
  name       String
  slug       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale, categoryId])
}

///////////////////////////////////////////////////////
// PRODUCT (10.11)
///////////////////////////////////////////////////////

model Product {
  id String @id @default(uuid())

  code String // 10.11
  name String
  slug String @unique

  description String? @db.Text

  // Ürün videoları YouTube'da barındırılır (S3 asset'i değil): kanonik watch URL'i
  // saklanır, gömme/thumbnail adresleri buradan türetilir.
  // bkz. core/helpers/products/youtubeVideo.ts
  assemblyVideoUrl String? // montaj videosu
  promoVideoUrl    String? // ürün tanıtım videosu

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  variants            ProductVariant[]
  // Varyant kod sisteminin ürün-modeli başına tutulan sözlükleri:
  // ölçü şablonu (hangi ölçüler zorunlu), ölçü kayıtları (kodun 3. segmenti),
  // versiyonlar (4. segment) ve tedarikçi harfleri (5. segment).
  measurementRequirements ProductMeasurementRequirement[]
  sizes                   ProductSize[]
  versions                VariantVersion[]
  supplierCodes           ProductSupplierCode[]
  assets              Asset[]
  attributeValues     ProductAttributeValue[]
  industrialUsages    ProductIndustrialUsage[]
  translations        ProductTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
  @@index([categoryId])
}

model ProductTranslation {
  id          String  @id @default(uuid())
  productId   String
  locale      String  @db.VarChar(16)
  name        String
  slug        String
  description String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale, productId])
}

model ProductAttribute {
  id String @id @default(uuid())

  code String @unique // usage_area, model_type, connection_type, profile_type, material_type, usage_type, hat_type
  name String

  displayOrder         Int     @default(0)
  isActive             Boolean @default(true)
  isCustomerAssignable Boolean @default(false)

  values ProductAttributeValue[]
  translations ProductAttributeTranslation[]
  valueTranslations ProductAttributeValueTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductAttributeTranslation {
  id                 String @id @default(uuid())
  productAttributeId String
  locale             String @db.VarChar(16)
  name               String

  productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productAttributeId, locale])
  @@index([locale, productAttributeId])
}

model ProductAttributeValue {
  id String @id @default(uuid())

  name String
  slug String

  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  parentValueId String?
  parentValue   ProductAttributeValue?  @relation("AttributeValueHierarchy", fields: [parentValueId], references: [id], onDelete: SetNull)
  childValues   ProductAttributeValue[] @relation("AttributeValueHierarchy")

  // 🔥 MANY TO MANY
  products                          Product[]
  assets                            Asset[]
  translations                      ProductAttributeValueTranslation[]
  customerSectors                   Customer[]                         @relation("CustomerSector")
  customerProductionGroups          Customer[]                         @relation("CustomerProductionGroup")
  customerUsageAreas                Customer[]                         @relation("CustomerUsageAreas")
  customerAttributeAssignments      CustomerAttributeValueAssignment[]
  productIndustrialSectors          ProductIndustrialUsage[]           @relation("ProductIndustrialUsageSector")
  productIndustrialProductionGroups ProductIndustrialUsage[]           @relation("ProductIndustrialUsageProductionGroup")
  productIndustrialUsageAreas       ProductIndustrialUsage[]           @relation("ProductIndustrialUsageArea")

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, name])
  @@index([attributeId])
  @@index([parentValueId])
}

model ProductAttributeValueTranslation {
  id                      String @id @default(uuid())
  productAttributeValueId String
  attributeId             String
  locale                  String @db.VarChar(16)
  name                    String
  slug                    String

  productAttributeValue ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)
  attribute             ProductAttribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productAttributeValueId, locale])
  @@unique([attributeId, locale, slug])
  @@index([locale, attributeId])
}

model ProductIndustrialUsage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sectorValueId String?
  sectorValue   ProductAttributeValue? @relation("ProductIndustrialUsageSector", fields: [sectorValueId], references: [id], onDelete: SetNull)

  productionGroupValueId String?
  productionGroupValue   ProductAttributeValue? @relation("ProductIndustrialUsageProductionGroup", fields: [productionGroupValueId], references: [id], onDelete: SetNull)

  usageAreaValueId String?
  usageAreaValue   ProductAttributeValue? @relation("ProductIndustrialUsageArea", fields: [usageAreaValueId], references: [id], onDelete: SetNull)

  usageFunction String? @db.Text
  // Varsayılan (TR) görsel. Locale'e özgü görsel
  // ProductIndustrialUsageTranslation.imageKey'de tutulur; o yoksa buraya düşülür.
  imageKey      String?
  displayOrder  Int     @default(0)

  translations ProductIndustrialUsageTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, displayOrder])
  @@index([sectorValueId])
  @@index([productionGroupValueId])
  @@index([usageAreaValueId])
}

model ProductIndustrialUsageTranslation {
  id                       String  @id @default(uuid())
  productIndustrialUsageId String
  locale                   String  @db.VarChar(16)
  // Nullable: görselde yazı olduğu için yalnız görseli çevrilen (metni ortak
  // kalan) satırlar mümkün olmalı.
  usageFunction            String? @db.Text
  imageKey                 String?

  productIndustrialUsage ProductIndustrialUsage @relation(fields: [productIndustrialUsageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productIndustrialUsageId, locale])
  @@index([locale, productIndustrialUsageId])
}

model Customer {
  id String @id @default(uuid())

  /// Firma adı. Tekillik YOK: Türkiye'de aynı unvanla birden çok firma olabiliyor;
  /// ayrım vergi numarası, adres ve konumdan yapılır.
  companyName            String?
  /// Yetkili kişi adı. Veri girişi panelinde firma kaydedilirken boş bırakılabilir;
  /// public web formunda ise ZORUNLUDUR (orada kişi kendini kaydeder). Kısıt bu
  /// yüzden şemada değil, yüzeye özel validator'larda.
  fullName               String?
  /// BİRİNCİL telefon. Arama, harita, iş talebi snapshot'ı, public form ve
  /// ürün→müşteri tablosu bunu okur. Ek numaralar `additionalPhones`'ta.
  phone                  String
  email                  String
  /// Firma web sitesi. Normalize edilerek saklanır ("acme.com" → "https://acme.com");
  /// kural core/helpers/crm/customerWebsite.ts içinde.
  websiteUrl             String?
  note                   String?        @db.Text
  status                 CustomerStatus @default(LEAD)
  generalDiscountPercent Decimal?       @db.Decimal(5, 2)
  defaultPaymentTermDays Int?
  creditLimit            Decimal?       @db.Decimal(12, 2)
  paymentTermNote        String?        @db.Text

  assignedSalesUserId String?
  assignedSalesUser   User?   @relation("AssignedSalesUser", fields: [assignedSalesUserId], references: [id], onDelete: SetNull)

  convertedAt       DateTime?
  convertedByUserId String?
  convertedByUser   User?     @relation("CustomerConvertedBy", fields: [convertedByUserId], references: [id], onDelete: SetNull)

  sectorValueId String?
  sectorValue   ProductAttributeValue? @relation("CustomerSector", fields: [sectorValueId], references: [id], onDelete: SetNull)

  productionGroupValueId String?
  productionGroupValue   ProductAttributeValue? @relation("CustomerProductionGroup", fields: [productionGroupValueId], references: [id], onDelete: SetNull)

  usageAreaValues           ProductAttributeValue[]            @relation("CustomerUsageAreas")
  attributeValueAssignments CustomerAttributeValueAssignment[]
  companyContactAssignments CustomerCompanyContactAssignment[]
  portalUsers               User[]                             @relation("CustomerPortalUsers")
  userInvitations           UserInvitation[]
  assignedProducts          CustomerAssignedProduct[]
  addresses                 CustomerAddress[]
  additionalPhones          CustomerPhone[]
  visits                    CustomerVisit[]
  businessRequests          BusinessRequest[]
  orders                    Order[]
  specialVariantPrices      CustomerVariantSpecialPrice[]
  campaignAnnouncements     CampaignAnnouncementRecipient[]
  /// Müşteriye ait kalıplar (üretim planlama).
  ownedMolds                Mold[]                             @relation("CustomerOwnedMolds")
  productionOrders          ProductionOrder[]                  @relation("CustomerProductionOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@index([assignedSalesUserId, status, createdAt])
  @@index([sectorValueId])
  @@index([productionGroupValueId])
}

/// Müşterinin EK telefon numaraları ("Muhasebe", "Satın Alma", "Cep"...).
/// Birincil numara `Customer.phone`'da kalır — mevcut okuyucular (arama, harita,
/// iş talebi snapshot'ı, public form) ona bağlı olduğu için tek tabloya taşınmadı.
///
/// Yazma TAM DEĞİŞİMDİR (deleteMany + createMany) ve her zaman
/// `core/helpers/crm/customerPhones.ts`'ten geçer: boşlar atılır, birincille ya da
/// birbiriyle AYNI HAT olan numaralar tekilleştirilir ("0532 000 00 00" ile
/// "+905320000000" aynıdır). Tekillik DB kısıtı DEĞİL, çünkü biçimler farklı olabilir.
model CustomerPhone {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Kullanıcının yazdığı biçimde saklanır (birincil `phone` ile aynı kural).
  number       String
  label        String?
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, displayOrder])
}

model UserInvitation {
  id String @id @default(uuid())

  userId String
  user   User   @relation("CustomerPortalInvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedByUser   User   @relation("CustomerPortalInvitationInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  email                              String
  tokenHash                          String    @unique
  expiresAt                          DateTime
  acceptedAt                         DateTime?
  requestedFirstName                 String?
  requestedLastName                  String?
  requestedCustomerContactTitle      String?
  requestedCustomerContactDepartment String?
  requestedIsPrimaryCustomerContact  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, expiresAt])
  @@index([userId])
}

model CustomerAttributeValueAssignment {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  source CustomerAttributeValueAssignmentSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, attributeValueId])
  @@index([customerId])
  @@index([attributeValueId])
}

model CompanyContact {
  id String @id @default(uuid())

  department    String
  name          String
  roleLabel     String?
  email         String?
  phone         String?
  whatsappPhone String?
  note          String? @db.Text
  isActive      Boolean @default(true)
  displayOrder  Int     @default(0)

  customerAssignments CustomerCompanyContactAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([department])
}

model CustomerCompanyContactAssignment {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyContactId String
  companyContact   CompanyContact @relation(fields: [companyContactId], references: [id], onDelete: Cascade)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  note         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, companyContactId])
  @@index([customerId, isActive, displayOrder])
  @@index([companyContactId])
}

model GeoCountry {
  id               Int      @id
  name             String
  iso3             String?
  iso2             String   @unique
  numericCode      String?  @map("numeric_code")
  phoneCode        String?  @map("phonecode")
  capital          String?
  currency         String?
  currencyName     String?  @map("currency_name")
  currencySymbol   String?  @map("currency_symbol")
  tld              String?
  native           String?
  population       BigInt?
  gdp              String?
  region           String?
  regionId         Int?     @map("region_id")
  subregion        String?
  subregionId      Int?     @map("subregion_id")
  nationality      String?
  areaSqKm         String?  @map("area_sq_km")
  postalCodeFormat String?  @map("postal_code_format")
  postalCodeRegex  String?  @map("postal_code_regex")
  timezones        Json?
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  emoji            String?
  emojiU           String?
  wikiDataId       String?

  states            GeoState[]
  cities            GeoCity[]
  customerAddresses CustomerAddress[]

  @@index([name])
  @@map("geo_countries")
}

model GeoState {
  id          Int      @id
  name        String
  countryId   Int      @map("country_id")
  countryCode String?  @map("country_code")
  countryName String?  @map("country_name")
  iso2        String?
  iso3166_2   String?
  fipsCode    String?  @map("fips_code")
  type        String?
  level       String?
  parentId    Int?     @map("parent_id")
  native      String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  timezone    String?
  wikiDataId  String?
  population  BigInt?

  country           GeoCountry        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities            GeoCity[]
  customerAddresses CustomerAddress[]

  @@index([countryId, name])
  @@index([countryCode])
  @@map("geo_states")
}

model GeoCity {
  id           Int      @id
  name         String
  stateId      Int?     @map("state_id")
  stateCode    String?  @map("state_code")
  stateName    String?  @map("state_name")
  countryId    Int      @map("country_id")
  countryCode  String?  @map("country_code")
  countryName  String?  @map("country_name")
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  native       String?
  type         String?
  level        String?
  parentId     Int?     @map("parent_id")
  population   BigInt?
  timezone     String?
  translations Json?
  wikiDataId   String?

  country           GeoCountry        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  state             GeoState?         @relation(fields: [stateId], references: [id], onDelete: SetNull)
  customerAddresses CustomerAddress[]

  @@index([countryId, name])
  @@index([stateId, name])
  @@map("geo_cities")
}

enum CustomerStatus {
  LEAD
  CUSTOMER
}

enum CustomerAttributeValueAssignmentSource {
  MANUAL
  LEGACY_BACKFILL
  SYSTEM
}

model WebRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  email   String
  phone   String?
  message String? @db.Text

  // B2B inquiry sepet snapshot (productId, variant info, quantity...)
  items Json

  status WebRequestStatus @default(NEW)

  @@index([email])
  @@index([status, createdAt])
}

enum WebRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

///////////////////////////////////////////////////////
// PRODUCT VARIANT (10.5.8.V1)
///////////////////////////////////////////////////////

/// Varyant = ürün modeli + ÖLÇÜ + VERSİYON (renk & hammadde). Tedarikçi varyantın
/// bir parçası DEĞİLDİR: aynı fiziksel ürünü birden çok tedarikçiden alabiliriz ve
/// her tedarikçinin kendi kodu/fiyatı/koli bilgisi `ProductVariantSupplier`
/// üzerinde yaşar. Tedarikçili tam kod (`10.5.8.V1.A`) da oradadır.
///
/// Kod üretimi tek kaynaktan gelir:
/// `core/helpers/productVariants/variantCode.ts` + `assignProductVariantCodes.ts`.
model ProductVariant {
  id String @id @default(uuid())

  name      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  /// Kodun 3. segmenti buradan gelir (ProductSize.code).
  productSizeId String
  size          ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Restrict)

  /// Kodun 4. segmenti buradan gelir (VariantVersion.code → "V1").
  /// Versiyon ÜRÜN MODELİ BAŞINA tanımlıdır ve önceden tanımlanmış olmalıdır.
  variantVersionId String
  version          VariantVersion @relation(fields: [variantVersionId], references: [id], onDelete: Restrict)

  /// "10.5.8.V1" — tedarikçi harfi İÇERMEZ.
  fullCode String @unique

  assets Asset[]

  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  variantSuppliers      ProductVariantSupplier[]
  assignedToCustomers   CustomerAssignedProduct[]
  requestItems          BusinessRequestItem[]
  orderItems            OrderItem[]
  customerSpecialPrices CustomerVariantSpecialPrice[]
  campaignItems         ProductVariantCampaignItem[]
  productionOrders      ProductionOrder[]
  productionProfile     ProductionVariantProfile?

  @@unique([productId, productSizeId, variantVersionId])
  @@index([productId])
  @@index([productSizeId])
  @@index([variantVersionId])
}

/// Ürün modeline özel ölçü şablonu: bu modelde HANGİ ölçülerin girilmesi gerektiği.
/// `Category.allowedAttributeValueIds`'in ürün-modeli karşılığıdır, ama düz bir id
/// listesi değil ilişki tablosudur — çünkü ölçü başına etiket, birim ve sıralama
/// önceliği taşımamız gerekir: "1.1" modelinde `R` = "Elcik Çapı", "1.8" modelinde
/// aynı `R` = "Kol Çapı".
model ProductMeasurementRequirement {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  measurementTypeId String
  measurementType   MeasurementType @relation(fields: [measurementTypeId], references: [id], onDelete: Restrict)

  /// Ürün modeline özel görünen ad — "Kol Çapı", "Burç Metriği".
  label String
  /// null → MeasurementType.baseUnit. Şablon cm/mm farkını burada ezebilir.
  unit  String?

  isRequired Boolean @default(true)
  /// Ölçü KODU sıralamasında anahtar önceliği (küçük olan baskın).
  sortPriority Int @default(0)
  /// Tablo kolon sırası.
  displayOrder Int @default(0)

  translations ProductMeasurementRequirementTranslation[]
  sizeValues   ProductSizeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, measurementTypeId, label])
  @@index([productId, displayOrder])
  @@index([measurementTypeId])
}

model ProductMeasurementRequirementTranslation {
  id            String @id @default(uuid())
  requirementId String
  locale        String @db.VarChar(16)
  label         String

  requirement ProductMeasurementRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, locale])
  @@index([locale, requirementId])
}

/// Ürün modeli içindeki bir ÖLÇÜ — kodun 3. segmenti.
///
/// `signature` = ZORUNLU ölçü imzası (`buildRequiredSignature`). Zorunlu ölçüleri
/// aynı olan varyantlar — opsiyonel bir ölçüsü farklı olsa ya da hiç girilmese bile
/// — TEK `ProductSize`'a, tek koda çözülür (`1.23.1.V1.A` / `.B` / `.C`). Opsiyonel
/// ölçü değerleri yine `ProductSizeValue`'da tutulur ama kodu belirlemez. `sortKey`
/// "küçükten büyüğe" numaralandırmayı besler; çok ölçülü modellerde (ör. "M4 + 10 cm")
/// şablondaki `sortPriority` sırasına göre çok anahtarlıdır. İkisi de
/// `core/helpers/productVariants/sizeSignature.ts` tarafından üretilir.
model ProductSize {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 1..N, append-only. Zorunlu imzası aynı olan kayıtlar aynı kodu paylaşır.
  code      Int
  signature String
  sortKey   String

  values   ProductSizeValue[]
  variants ProductVariant[]
  /// Bu ölçüyü basan kalıp gözleri (üretim planlama). Kalıbı olan ölçü `Restrict`
  /// ile korunur: varyantı kalmasa bile silinmez (bkz. `removeOrphanSizes`).
  moldOutputs MoldOutput[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tekilleştirme "zorunlu ölçü imzası" anahtarıyla UYGULAMA katmanında yapılır
  // (bkz. productVariantWriter); DB'de `signature` üzerinde unique KISIT YOK —
  // yalnız arama/eşleştirme için index var. Eski kayıtların birleştirilmesi tek
  // seferlik backfill script'iyle yapıldı.
  @@unique([productId, code])
  @@index([productId, sortKey])
  @@index([productId, signature])
}

model ProductSizeValue {
  id String @id @default(uuid())

  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  /// Şablonda tanımlı olmayan ölçü girilemesin diye doğrudan gereksinime bağlanır;
  /// Restrict, kullanımdaki bir gereksinimin sessizce silinmesini de engeller.
  requirementId String
  requirement   ProductMeasurementRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  /// Her zaman dolu: düz sayısal girişte kullanıcının verdiği değer, `rawValue`
  /// dolu olan bileşik girişte ("10*30") ise SIRALAMA SÜRROGATI — ilk sayı (10).
  /// Sıralama/kod üretimi (sizeSignature.ts) bu alan üzerinden çalışmaya devam eder.
  value Float
  /// Kullanıcının birebir girdiği bileşik ölçü metni — yalnız "SAYI*SAYI" deseni
  /// ("10*30", "10x30", "10×30"). Düz sayısal girişte NULL kalır. Doluysa imza/
  /// görüntüleme bu metni birebir kullanır, `value` yalnız sıralama içindir.
  rawValue String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productSizeId, requirementId])
  @@index([requirementId])
}

/// Ürün modeli içindeki RENK + HAMMADDE kombinasyonu — kodun 4. segmenti ("V1").
/// Ölçüden farklı olarak doğal bir büyüklük sırası yoktur: ilk atamada derli toplu
/// ve deterministik sıralanır, sonrasında append-only'dur.
/// Renk + hammadde kombinasyonu — kodun 4. segmenti ("V1"). **ÜRÜN MODELİ BAŞINA.**
///
/// Her ürün modelinin kendi V listesi vardır: "10.5" içinde Siyah+Bakalit V1
/// olabilirken "10.8" içinde aynı kombinasyon başka bir numara taşıyabilir. Ölçü
/// koduyla aynı mantık — `10.5.1` ile `10.8.1` de farklı ölçülerdir.
///
/// Numara APPEND-ONLY'dur ve ASLA yeniden sıralanmaz. Asıl hata ürün başına olması
/// DEĞİL, her kayıtta renk koduna göre 1..N yeniden numaralandırılmasıydı: bir ürüne
/// yeni renk eklemek o üründeki tüm versiyon kodlarını kaydırıyor, dışarı çıkmış
/// kodları (katalog, teklif, tedarikçi siparişi) yanlış varyanta işaret eder hâle
/// getiriyordu. Ölçünün aksine versiyonun sıralanması için bir iş kuralı yok.
///
/// ÖNCE TANIMLANMALI: varyant girişi sırasında bilinmeyen bir kombinasyon
/// OTOMATİK EKLENMEZ, reddedilir (bkz. productVariantWriter). Kod ataması bilinçli
/// bir karar olmalı.
model VariantVersion {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 1 → "V1". Ürün modeli içinde tekil.
  code Int

  colorId String?
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: Restrict)

  /// Hammadde ÇOKLUDUR.
  materials Material[]

  /// "color:<id>|materials:<id>,<id>" — aynı kombinasyon bir üründe iki kez tanımlanamaz.
  signature String

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@unique([productId, signature])
  @@index([productId, code])
  @@index([colorId])
}

/// Ürün modeli içinde tedarikçiye verilen harf — kodun 5. segmenti ("A").
/// Kilit durumundan BAĞIMSIZ olarak her zaman append-only'dur: verilmiş bir harf
/// asla başka tedarikçiye devredilmez, aradan çıkan tedarikçinin boşluğu doldurulmaz.
model ProductSupplierCode {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  code String

  /// Ürün modeli + tedarikçi harfi başına TEK teknik resim (type & role =
  /// TECHNICAL_DRAWING). Async yükleme: presign PENDING_UPLOAD satır oluşturur,
  /// S3 ObjectCreated → confirm Lambda ACTIVE'e çevirir. Değiştirme = eskiyi sil
  /// + yeniyi yükle (UI senkron DELETE /assets/{id}).
  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, supplierId])
  @@unique([productId, code])
  @@index([supplierId])
}

///////////////////////////////////////////////////////
// MEASUREMENT TYPE
///////////////////////////////////////////////////////

enum MeasurementCode {
  D // Diameter (Çap) / Metrik (D)
  D1 // Metrik (D1)
  D2 // Metrik (D2)
  R // Radius (R) / Çap (R)
  R1 // Çap (R1)
  R2 // Çap (R2)
  R3 // Çap (R3)
  L // Length (Uzunluk)
  L1 // Uzunluk (L1)
  L2 // Uzunluk (L2)
  T // Thickness (Kalınlık)
  A // Angle (Açı)
  W // Width (Genişlik)
  H // Height (Yükseklik) / Ürün Yüksekliği
  H1 // Ürün Yüksekliği (H1)
  H2 // Civata Uzunluğu (H2)
  H3 // Yükseklik (H3)
  PT // Profile Thickness (Profil Kalınlığı)
  M // Metric thread size (M8, M6...)
  R_L // R-L
}

model MeasurementType {
  id           String          @id @default(uuid())
  name         String
  code         MeasurementCode @unique
  baseUnit     String // mm, degree, kg
  displayOrder Int             @default(0)

  // Ölçüler artık varyanta doğrudan değil, ürün modelinin ölçü şablonuna ve
  // oradan ProductSizeValue'ya bağlanır.
  requirements  ProductMeasurementRequirement[]
  translations  MeasurementTypeTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeasurementTypeTranslation {
  id                String @id @default(uuid())
  measurementTypeId String
  locale            String @db.VarChar(16)
  name              String

  measurementType MeasurementType @relation(fields: [measurementTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([measurementTypeId, locale])
  @@index([locale, measurementTypeId])
}

// ProductMeasurement kaldırıldı: ölçüler artık varyant başına DEĞİL, ürün modeli
// başına tekilleştirilmiş ProductSize/ProductSizeValue üzerinde tutuluyor. Aksi
// hâlde aynı fiziksel ölçü her tedarikçi satırında tekrar edip kod tekilliğini
// imkânsız kılıyordu.

model Supplier {
  id String @id @default(uuid())

  name                        String
  contactName                 String?
  phone                       String?
  address                     String? @db.Text
  taxNumber                   String?
  defaultPaymentTermDays      Int?
  isActive                    Boolean @default(true)
  /// Kendi üretim birimimiz ("Ceyhunlar Üretim"). Üretim planlama yalnız bu tedarikçiye bağlı
  /// varyantları üretime alır. En çok BİR tedarikçi işaretlenebilir (uygulama kuralı, admin uçları).
  isInHouseProduction         Boolean @default(false)
  assignedPurchasingSuppliers User[]  @relation("SupplierPurchasingAssignments")

  variantSuppliers ProductVariantSupplier[]
  /// Ürün modeli başına verilen harf (kodun 5. segmenti).
  productCodes     ProductSupplierCode[]
  users            User[]
  businessRequests BusinessRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

/// "İlgili Ürünler" artık yalnızca profil eşleşmesinden türer (müşteri
/// sektör/üretim grubu/kullanım alanı ↔ ProductIndustrialUsage); manuel insan
/// seçimi kaldırıldığı için CustomerFeaturedProduct modeli de kaldırıldı.

/// Portalda "Favori Ürün Varyantlarım" olarak gösterilir. İki kaynaktan beslenir:
/// temsilci/admin ataması (STAFF) ve müşterinin kendi kalp işareti (CUSTOMER).
/// Aynı varyant iki kaynakta da bulunabilir; bu yüzden tekillik kısıtı `source`
/// içerir ve toplu yazma yolu (replaceAssignedProducts) YALNIZ STAFF satırlarına
/// dokunur — aksi hâlde temsilci kaydı müşterinin favorilerini silerdi.
enum CustomerAssignedProductSource {
  STAFF
  CUSTOMER
}

model CustomerAssignedProduct {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  displayOrder Int @default(0)

  /// Mevcut satırların tamamı temsilci atamasıdır; STAFF varsayılanı geri dolduruyu üstlenir.
  source CustomerAssignedProductSource @default(STAFF)

  createdByUserId String
  createdByUser   User   @relation("CustomerAssignedProductCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productVariantId, source])
  @@index([customerId, source, displayOrder])
  @@index([productVariantId])
  @@index([createdByUserId])
}

model CustomerAddress {
  id String @id @default(uuid())

  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippingOrders Order[]

  label                    String
  contactName              String?
  phone                    String?
  email                    String?
  countryId                Int?
  stateId                  Int?
  cityId                   Int?
  country                  String                           @default("Turkiye")
  city                     String
  district                 String?
  line1                    String
  line2                    String?
  postalCode               String?
  taxOffice                String?
  taxNumber                String?
  latitude                 Decimal?                         @db.Decimal(10, 8)
  longitude                Decimal?                         @db.Decimal(11, 8)
  locationSource           CustomerAddressLocationSource?
  locationAccuracy         CustomerAddressLocationAccuracy?
  geocodingProvider        String?
  geocodingPlaceId         String?
  geocodingLabel           String?
  geocodingRaw             Json?
  geocodedAt               DateTime?
  geocodingExpiresAt        DateTime?
  locationVerifiedAt       DateTime?
  locationVerifiedByUserId String?
  isPrimary                Boolean                          @default(false)
  isBilling                Boolean                          @default(false)
  isShipping               Boolean                          @default(true)
  note                     String?                          @db.Text
  displayOrder             Int                              @default(0)

  countryRef             GeoCountry? @relation(fields: [countryId], references: [id], onDelete: SetNull)
  stateRef               GeoState?   @relation(fields: [stateId], references: [id], onDelete: SetNull)
  cityRef                GeoCity?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  locationVerifiedByUser User?       @relation("CustomerAddressVerifiedByUser", fields: [locationVerifiedByUserId], references: [id], onDelete: SetNull)

  visits CustomerVisit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, displayOrder])
  @@index([customerId, isPrimary])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@index([latitude, longitude])
  @@index([geocodingProvider, geocodingExpiresAt])
  @@index([locationVerifiedByUserId])
}

enum CustomerAddressLocationSource {
  MANUAL_PIN
  GEOCODED
  IMPORTED
  CUSTOMER_SUBMITTED
}

enum CustomerAddressLocationAccuracy {
  EXACT
  STREET
  DISTRICT
  CITY
  UNKNOWN
}

model GeocodingCache {
  id String @id @default(uuid())

  provider     String
  queryType    GeocodingCacheQueryType
  cacheKey     String
  responseJson Json
  expiresAt    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, queryType, cacheKey])
  @@index([expiresAt])
}

enum GeocodingCacheQueryType {
  SEARCH
  REVERSE
}

model CustomerVisit {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  ownerUserId String
  ownerUser   User   @relation("CustomerVisitOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)

  /// Ziyaret edilen adres — il/ilçe raporlaması ve satış haritasıyla entegrasyon buradan gelir.
  /// Nullable: telefon/video ziyaretlerde veya adres seçilmeden hızlı girişte boş kalabilir.
  addressId String?
  address   CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  scheduledAt  DateTime
  status       CustomerVisitStatus   @default(PLANNED)
  type         CustomerVisitType     @default(IN_PERSON)
  title        String
  note         String?               @db.Text
  /// Yalnız status COMPLETED olduğunda anlamlıdır; PLANNED/CANCELED'da boş kalır.
  outcome      CustomerVisitOutcome?
  nextActionAt DateTime?
  completedAt  DateTime?

  createdByUserId String
  createdByUser   User   @relation("CustomerVisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, scheduledAt])
  @@index([customerId, status, scheduledAt])
  @@index([ownerUserId, status, scheduledAt])
  @@index([createdByUserId])
  @@index([addressId])
  @@index([nextActionAt])
}

enum CustomerVisitStatus {
  PLANNED
  COMPLETED
  CANCELED
}

enum CustomerVisitType {
  IN_PERSON
  PHONE
  VIDEO
}

enum CustomerVisitOutcome {
  POSITIVE
  FOLLOW_UP_NEEDED
  NOT_INTERESTED
  ORDER_PLACED
}

model ProductVariantSupplier {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Ürün modeli içindeki tedarikçi harfi ("A") — ProductSupplierCode'dan yazılan
  /// snapshot. Aramanın ve gösterimin join'siz çalışması için burada da tutulur.
  supplierCode String?
  /// Tedarikçili TAM kod: "10.5.8.V1.A".
  fullCode     String? @unique

  isActive Boolean @default(false)

  // ── Fiyat zinciri ────────────────────────────────────────────────────────────
  // DİKKAT: `price` TEDARİKÇİNİN BİZE fiyatıdır (alış) — operatörün "liste fiyatı"
  // dediği alan budur. `listPrice` ise BİZİM MÜŞTERİYE liste fiyatımızdır ve
  // netCost × (1 + profitRate) ile türetilir (bkz. helpers/pricing/productVariantSupplier.ts).
  price                 Decimal   @default(0) @db.Decimal(10, 2)
  operationalCostRate   Decimal?  @db.Decimal(5, 2)
  netCost               Decimal?  @db.Decimal(10, 2)
  profitRate            Decimal?  @db.Decimal(5, 2)
  listPrice             Decimal?  @db.Decimal(10, 2)
  paymentTermDays       Int?
  /// Tedarikçinin kendi ürün kodu — "AS231".
  supplierVariantCode   String?
  supplierNote          String?   @db.Text
  pricingUpdatedAt      DateTime?
  minOrderQty           Int?
  stockQty              Int?
  availabilityUpdatedAt DateTime?
  currency              String    @default("TRY")

  // ── Tedarikçiye özel ürün/lojistik bilgisi ───────────────────────────────────
  /// Ürünün üzerinde tedarikçinin kendi logosu var mı.
  hasSupplierLogo Boolean  @default(false)
  /// Bir kolide/pakette kaç adet.
  unitsPerPackage Int?
  packageLengthMm Decimal? @db.Decimal(10, 2)
  packageWidthMm  Decimal? @db.Decimal(10, 2)
  packageHeightMm Decimal? @db.Decimal(10, 2)
  packageWeightKg Decimal? @db.Decimal(10, 3)
  /// Minimum termin süresi (gün).
  minLeadTimeDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, supplierId])
  @@index([variantId])
  @@index([supplierId])
  @@index([supplierCode])
}

///////////////////////////////////////////////////////
// PRODUCT VARIANT CAMPAIGN
///////////////////////////////////////////////////////

/// Kampanya, MÜŞTERİYE ÖZEL DEĞİLDİR: tüm müşterilere aynı yüzde indirimi açar.
/// Müşteriye özel pazarlık (CustomerVariantSpecialPrice) her koşulda kampanyayı
/// ezer; kampanya ile genel iskonto ise ikisi de liste fiyatına yüzde olduğu için
/// karşılaştırılır ve büyük olan uygulanır (bkz. customerPricing.ts).
model ProductVariantCampaign {
  id String @id @default(uuid())

  title       String
  description String? @db.Text

  /// Kampanya geneli indirim; kalem bazında ezilebilir.
  discountPercent Decimal @db.Decimal(5, 2)

  validFrom  DateTime?
  validUntil DateTime?

  status ProductVariantCampaignStatus @default(DRAFT)

  createdByUserId String
  createdByUser   User   @relation("ProductVariantCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  items         ProductVariantCampaignItem[]
  announcements CampaignAnnouncement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, validFrom, validUntil])
  @@index([createdByUserId])
}

model ProductVariantCampaignItem {
  id String @id @default(uuid())

  campaignId String
  campaign   ProductVariantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  /// Doluysa kampanya genelindeki oranın yerine geçer.
  discountPercent Decimal? @db.Decimal(5, 2)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, productVariantId])
  @@index([productVariantId])
  @@index([campaignId, displayOrder])
}

enum ProductVariantCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Kampanya duyurusu: satış temsilcisinin seçtiği müşterilere sıcak temas listesi.
/// Kampanya oluşturulduğunda OTOMATİK bildirim gitmez — temsilci bilinçli olarak
/// müşteri seçer ki gerçek geri dönüşler takip edilebilsin.
model CampaignAnnouncement {
  id String @id @default(uuid())

  campaignId String
  campaign   ProductVariantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Duyuruyu oluşturan satış temsilcisi.
  createdByUserId String
  createdByUser   User   @relation("CampaignAnnouncementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Duyuru geneli not (kampanya mesajının özeti, hedef vb.).
  note String? @db.Text

  recipients CampaignAnnouncementRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, createdAt])
  @@index([createdByUserId, createdAt])
}

model CampaignAnnouncementRecipient {
  id String @id @default(uuid())

  announcementId String
  announcement   CampaignAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Kanal alıcı bazındadır: bir müşteri aranır, diğerine mail atılır.
  channel CampaignAnnouncementChannel

  status CampaignAnnouncementRecipientStatus @default(PENDING)

  /// Görüşme notu — temsilcinin o müşteriyle teması hakkında yazdığı.
  note String? @db.Text

  contactedAt DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([announcementId, customerId])
  @@index([customerId, createdAt])
  @@index([announcementId, status])
}

enum CampaignAnnouncementChannel {
  /// Temsilci kendi telefonundan aradı/yazdı; sistem yalnız kaydı tutar.
  MANUAL
  EMAIL
  WHATSAPP
}

enum CampaignAnnouncementRecipientStatus {
  PENDING
  REACHED
  RESPONDED
  NOT_INTERESTED
  UNREACHABLE
}

model CustomerVariantSpecialPrice {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("TRY")

  minOrderQuantity Int?
  maxOrderQuantity Int?

  paymentTermDays  Int?
  paymentTermLabel String?
  paymentSchedule  Json?

  validFrom  DateTime?
  validUntil DateTime?

  taxIncluded Boolean @default(false)

  deliveryTerm      String?
  contractReference String?
  note              String? @db.Text
  internalNote      String? @db.Text

  isActive Boolean @default(true)

  createdByUserId String
  createdByUser   User   @relation("CustomerVariantSpecialPriceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  approvedByUserId String?
  approvedByUser   User?     @relation("CustomerVariantSpecialPriceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productVariantId])
  @@index([customerId, isActive])
  @@index([productVariantId])
  @@index([validFrom, validUntil])
  @@index([createdByUserId])
  @@index([approvedByUserId])
}

enum BusinessRequestDomain {
  SALES
  PURCHASING
}

enum BusinessRequestType {
  CUSTOMER_PROFILE_CHANGE
  CUSTOMER_ORDER_REQUEST
  CUSTOMER_DOCUMENT_REQUEST
  CUSTOMER_PRICING_REQUEST
  SUPPLIER_PROFILE_CHANGE
  SUPPLIER_PRICING_CHANGE
  SUPPLIER_CAPABILITY_CHANGE
  SUPPLIER_CATEGORY_CREATE
  SUPPLIER_PRODUCT_CREATE
  SUPPLIER_VARIANT_CREATE
  OFFER_DISCOUNT_REQUEST
  PAYMENT_TERM_REQUEST
}

enum BusinessRequestStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  FAILED
}

enum BusinessRequestEntityType {
  CATEGORY
  CUSTOMER
  SUPPLIER
  PRODUCT
  PRODUCT_VARIANT
  ORDER
  OFFER
  PAYMENT_TERM
  DOCUMENT
  OTHER
}

enum BusinessRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderStatus {
  APPROVED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum ApprovalRole {
  CUSTOMER
  SUPPLIER
  SALES
  SALES_DIRECTOR
  PURCHASING
  ADMIN
  OWNER
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

model BusinessRequest {
  id String @id @default(cuid())

  domain   BusinessRequestDomain
  type     BusinessRequestType
  status   BusinessRequestStatus   @default(PENDING_APPROVAL)
  priority BusinessRequestPriority @default(NORMAL)

  title       String
  description String? @db.Text

  entityType BusinessRequestEntityType?
  entityId   String?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  requestedByUserId String
  requestedByUser   User   @relation("BusinessRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  requesterRole ApprovalRole

  workflowExecutionArn String? @unique
  workflowTaskToken    String? @db.Text

  requestedData     Json
  currentSnapshot   Json?
  completedSnapshot Json?

  order Order?

  decidedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  items         BusinessRequestItem[]
  approvalSteps BusinessRequestApprovalStep[]
  activityLogs  ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain, status, createdAt])
  @@index([type, status, createdAt])
  @@index([requestedByUserId, createdAt])
  @@index([customerId, status, createdAt])
  @@index([supplierId, status, createdAt])
}

model Order {
  id String @id @default(cuid())

  orderNumber String      @unique
  status      OrderStatus @default(APPROVED)
  title       String

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  requestedByUserId String?
  requestedByUser   User?   @relation("CustomerOrderRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  sourceRequestId String?          @unique
  sourceRequest   BusinessRequest? @relation(fields: [sourceRequestId], references: [id], onDelete: SetNull)

  shippingAddressId       String?
  shippingAddress         CustomerAddress? @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  shippingAddressLabel    String?
  shippingAddressSnapshot Json?

  referenceCode         String?
  currency              String    @default("TRY")
  totalQuantity         Int       @default(0)
  discountPercent       Decimal?  @db.Decimal(5, 2)
  listSubtotal          Decimal?  @db.Decimal(12, 2)
  customerSubtotal      Decimal?  @db.Decimal(12, 2)
  requestedDeliveryDate DateTime?
  paymentTermDays       Int?
  paymentTermNote       String?   @db.Text
  commercialNote        String?   @db.Text
  negotiationNote       String?   @db.Text
  approvedFromRequestAt DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  quantity          Int      @default(1)
  listUnitPrice     Decimal? @db.Decimal(12, 2)
  customerUnitPrice Decimal? @db.Decimal(12, 2)
  listLineTotal     Decimal? @db.Decimal(12, 2)
  customerLineTotal Decimal? @db.Decimal(12, 2)
  currency          String   @default("TRY")
  note              String?  @db.Text
  data              Json?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, displayOrder])
  @@index([productVariantId])
}

model BusinessRequestItem {
  id String @id @default(uuid())

  requestId String
  request   BusinessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  quantity Int     @default(1)
  note     String? @db.Text
  data     Json?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, displayOrder])
  @@index([productVariantId])
}

model BusinessRequestApprovalStep {
  id String @id @default(cuid())

  requestId String
  request   BusinessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder    Int
  requiredRole ApprovalRole

  assignedUserId String?
  assignedUser   User?   @relation("BusinessRequestStepAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  status ApprovalStepStatus @default(PENDING)

  decidedByUserId String?
  decidedByUser   User?     @relation("BusinessRequestStepDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, stepOrder])
  @@index([assignedUserId, status, createdAt])
  @@index([requiredRole, status, createdAt])
  @@index([decidedByUserId, createdAt])
}

model ActivityLog {
  id String @id @default(cuid())

  requestId String?
  request   BusinessRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  source      String
  eventType   String
  title       String
  description String? @db.Text
  data        Json?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

///////////////////////////////////////////////////////
// AUDIT LOG
// Veri değişikliği denetim kaydı: kim, ne zaman, nereden, neyi, neyden neye.
// `ActivityLog` ile KARIŞTIRMA: o, iş talebi akışının olay-tabanlı (asenkron) zaman
// tüneli; bu tablo değişiklikle AYNI transaction'da yazılır (kayıt yazılamazsa
// değişiklik de geri alınır) ve yalnız EKLENİR — güncelleme/silme yolu yoktur.
// Kurallar: AGENTS.md § "When adding audit logging to a model".
///////////////////////////////////////////////////////

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditActorType {
  /// Kimliği doğrulanmış API kullanıcısı (Cognito JWT → authMiddleware → User).
  USER
  /// İnsan olmayan aktör: olay tetikli Lambda, cron, operatör CLI'ı.
  SYSTEM
  /// Giriş yapmamış kişi: sitedeki public form (web formundan gelen potansiyel müşteri).
  /// Kimliği yoktur; IP ve tarayıcı bilgisi kayda girer.
  ANONYMOUS
}

model AuditLog {
  id String @id @default(uuid())

  /// Model adı ("Category"). String: yeni bir modeli denetlemek migration istemesin.
  entityType  String
  /// Kaydın id'si. FK YOK: kayıt silinse de geçmişi kalır.
  entityId    String
  /// Olay anındaki okunur ad ("10 · Bakalit Tutamaklar") — silinen kayıt da tanınsın.
  entityLabel String?
  action      AuditAction

  actorType       AuditActorType @default(USER)
  actorUserId     String?
  actorUser       User?          @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Aktörün OLAY ANINDAKİ künyesi: kullanıcı silinse ya da adı / grubu değişse de
  /// kayıt okunur kalır (`actorUserId` o zaman NULL'a düşer).
  actorCognitoSub String?
  actorEmail      String?
  actorName       String?
  actorGroups     String[]       @default([])

  /// İşlemi başlatan uç ("PUT /categories/{id}") ya da sistem kaynağı.
  source    String
  /// API Gateway requestId — CloudWatch'taki `correlationId` ile aynı değer.
  requestId String?
  ipAddress String?
  userAgent String?

  /// [{ field, before, after }] — UPDATE'te yalnız değişen alanlar; CREATE'te
  /// `before`, DELETE'te `after` null.
  changes  Json
  /// Olayın bağlamı (silmede kaskadla gidenler, iş talebi id'si gibi).
  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model Material {
  id String @id @default(uuid())

  name String
  code String? // PP, PE, PVC gibi

  // bkz. Color.versions — hammadde de versiyon kaydına bağlanır.
  versions     VariantVersion[]
  assets       Asset[]
  translations MaterialTranslation[]
  /// Üretim bilgisi (yoğunluk, kurutma, çevrim katsayısı) — ayrı 1:1 tablo.
  processProfile MaterialProcessProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model MaterialTranslation {
  id         String @id @default(uuid())
  materialId String
  locale     String @db.VarChar(16)
  name       String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, locale])
  @@index([locale, materialId])
}

enum AssetType {
  IMAGE
  VIDEO
  PDF
  TECHNICAL_DRAWING
  CERTIFICATE
}

// ASSEMBLY_VIDEO kaldırıldı: montaj videosu artık S3 asset'i değil,
// Product.assemblyVideoUrl üzerinde tutulan bir YouTube linki.
enum AssetRole {
  PRIMARY
  ANIMATION
  GALLERY
  DOCUMENT
  TECHNICAL_DRAWING
  MODEL_3D
  CERTIFICATE
}

// Asset yükleme yaşam döngüsü. PENDING_UPLOAD: presign sırasında satır oluşturuldu,
// S3 nesnesi henüz onaylanmadı. ACTIVE: S3 ObjectCreated event'i satırı doğruladı
// (ya da event'siz eski/senkron akışlardan geldi). @default(ACTIVE) → mevcut satırlar
// ve diğer asset akışları (ürün, materyal, attribute value, kullanıcı fotoğrafı)
// backfill'siz geçerli kalır.
enum AssetUploadStatus {
  PENDING_UPLOAD
  ACTIVE
}

// kaldırıldı
// isPrimary Boolean   @default(false)
model Asset {
  id String @id @default(uuid())

  key           String // S3 key
  mimeType      String // image/png, image/gif, application/pdf
  type          AssetType
  role          AssetRole
  model3dConfig Json?

  uploadStatus AssetUploadStatus @default(ACTIVE)
  uploadedAt   DateTime? // S3 ObjectCreated onayında dolar

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  productAttributeValueId String?
  productAttributeValue   ProductAttributeValue? @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  productSupplierCodeId String?
  productSupplierCode   ProductSupplierCode? @relation(fields: [productSupplierCodeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([productId])
  @@index([variantId])
  @@index([productAttributeValueId])
  @@index([materialId])
  @@index([productSupplierCodeId])
  @@index([uploadStatus, createdAt])
}

///////////////////////////////////////////////////////
// ÜRETİM PLANLAMA — TANIMLAR
// docs/production-planning.md §5.1. Tipler: mm / ton / dakika / adet `Int`;
// çevrim süresi, ağırlık gibi mühendislik değerleri `Float` (ProductSizeValue.value
// gibi); para `Decimal`. Boş bırakılan teknik alan planı KİLİTLEMEZ — uygunluk
// motoru "doğrulanamadı" uyarısı üretir.
///////////////////////////////////////////////////////

/// Makinelerin durduğu parkur / hol — planlama tahtasında satır grubu.
model ProductionArea {
  id        String  @id @default(uuid())
  code      String  @unique
  name      String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  notes     String? @db.Text

  /// Alandaki makinelerin varsayılan vardiya düzeni; makine kendi düzeniyle ezebilir.
  shiftPatternId String?
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  machines           ProductionMachine[]
  calendarExceptions ProductionCalendarException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

enum ProductionMachineStatus {
  ACTIVE
  MAINTENANCE
  BREAKDOWN
  INACTIVE
}

/// Plastik enjeksiyon makinesi. Kalıp uygunluğu (kapama kuvveti, kolonlar arası,
/// kalıp kalınlığı aralığı, strok, baskı kapasitesi) bu alanlardan hesaplanır.
/// Ayrı `isActive` YOK: `status = INACTIVE` tek kaynaktır.
model ProductionMachine {
  id              String  @id @default(uuid())
  code            String  @unique
  name            String
  brand           String?
  model           String?
  serialNumber    String?
  manufactureYear Int?

  areaId String
  area   ProductionArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  status ProductionMachineStatus @default(ACTIVE)

  /// Kapama kuvveti (ton).
  clampForceTon          Int
  /// Kolonlar arası mesafe (mm): kalıbın genişliği/yüksekliği buradan geçmeli.
  tieBarHorizontalMm     Int?
  tieBarVerticalMm       Int?
  /// Plakalar arasına sığan kalıp kalınlığı aralığı (mm).
  minMoldHeightMm        Int?
  maxMoldHeightMm        Int?
  /// Açılma stroku (mm).
  maxOpeningStrokeMm     Int?
  /// Plakalar arası maksimum açıklık (mm) — hidrolik kapamada (ör. Arburg C) açılma
  /// kalıp kalınlığıyla azalır: kullanılabilir açılma = min(strok, açıklık − kalınlık).
  /// Dizlili makinede boş kalır (strok kalınlıktan bağımsız).
  maxDaylightMm          Int?
  /// Maksimum baskı ağırlığı (g) — föydeki PS değeri; hafif hammaddede (PP) daha düşük.
  shotCapacityG          Float?
  screwDiameterMm        Int?
  /// Merkezleme bileziği çapı (mm).
  locatingRingDiameterMm Int?
  hotRunnerZones         Int     @default(0)
  /// Maça çekme (hidrolik) devre sayısı.
  coreCircuits           Int     @default(0)
  hasRobot               Boolean @default(false)

  /// Planlama verimi (%) — süre hesabında kullanılır, planlanan işe kopyalanır.
  plannedEfficiencyPercent Int      @default(85)
  /// Makine saat maliyeti — "en ekonomik" öneri sıralaması için.
  hourlyCost               Decimal? @db.Decimal(10, 2)
  currency                 String   @default("TRY")

  /// Boşsa alanın, o da boşsa varsayılan (`isDefault`) vardiya düzeni geçerlidir.
  shiftPatternId String?
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: SetNull)

  sortOrder Int     @default(0)
  notes     String? @db.Text

  moldProfiles       MoldMachineProfile[]
  productionJobs     ProductionJob[]
  downtimes          MachineDowntime[]
  calendarExceptions ProductionCalendarException[]
  shiftAssignments   MachineShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([areaId, sortOrder])
}

enum MoldStatus {
  ACTIVE
  IN_MAINTENANCE
  BROKEN
  RETIRED
}

enum MoldOwnership {
  COMPANY
  CUSTOMER
}

/// Kalıp. Hangi ölçüleri kaç gözle bastığı `MoldOutput`'ta: aile kalıbında aynı
/// ürün modelinin farklı ölçüleri de, FARKLI ürün modellerinin ölçüleri de olabilir.
/// Tek baskı tüm gözleri aynı anda ve aynı renk + hammaddeyle doldurur.
/// Ayrı `isActive` YOK: `status = RETIRED` tek kaynaktır.
model Mold {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  status    MoldStatus    @default(ACTIVE)
  ownership MoldOwnership @default(COMPANY)

  /// Müşteriye ait kalıbın sahibi.
  ownerCustomerId String?
  ownerCustomer   Customer? @relation("CustomerOwnedMolds", fields: [ownerCustomerId], references: [id], onDelete: SetNull)

  requiredClampForceTon   Int?
  /// Dış ölçüler (mm): genişlik/yükseklik kolonlar arasından geçmeli, kalınlık
  /// makinenin kalıp kalınlığı aralığında olmalı.
  widthMm                 Int?
  heightMm                Int?
  thicknessMm             Int?
  weightKg                Float?
  requiredOpeningStrokeMm Int?
  locatingRingDiameterMm  Int?
  hotRunnerZones          Int     @default(0)
  coreCircuitsRequired    Int     @default(0)
  requiresRobot           Boolean @default(false)

  /// Referans çevrim süresi (sn). Hammadde katsayısı ve kalıp-makine kartı ezebilir.
  standardCycleTimeSec Float
  /// Yolluk ağırlığı (g) — baskı ağırlığı = Σ(göz × parça ağırlığı) + yolluk.
  runnerWeightG        Float?
  expectedScrapPercent Float  @default(0)
  /// Söküm + bağlama + ısınma (dk).
  setupMinutes         Int    @default(60)

  /// Baskı sayacı; `maintenanceIntervalShots` doluysa her N baskıda bakım.
  totalShots               Int       @default(0)
  maintenanceIntervalShots Int?
  shotsAtLastMaintenance   Int       @default(0)
  lastMaintenanceAt        DateTime?

  storageLocation String?
  notes           String? @db.Text

  outputs         MoldOutput[]
  productionJobs  ProductionJob[]
  machineProfiles MoldMachineProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([ownerCustomerId])
}

/// Kalıbın bir göz grubu: hangi ÖLÇÜDEN (ürün modeli + ölçü, ör. `10.5.8`) kaç göz.
/// Kalıp varyanta değil ölçüye bağlanır: aynı kalıp o ölçünün tüm renk/hammadde
/// versiyonlarını basar. Ölçü `Restrict` ile korunur — ölçü silen her akış kalıbı
/// olan ölçüyü atlamalı ya da anlaşılır bir hatayla durmalı (FK hatası 500 döner).
model MoldOutput {
  id String @id @default(uuid())

  moldId String
  mold   Mold   @relation(fields: [moldId], references: [id], onDelete: Cascade)

  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Restrict)

  /// Bu ölçüden aktif göz sayısı.
  cavities    Int
  /// Net parça ağırlığı (g).
  partWeightG Float?

  /// İşlerin bu göz grubundan çıktısı — `Restrict`: işe bağlı göz grubu silinemez.
  jobOutputs ProductionJobOutput[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moldId, productSizeId])
  @@index([productSizeId])
}

/// Kalıp + makine kartı (opsiyonel): o makinede kanıtlanmış çevrim/setup süresi,
/// tercih ya da bilinçli engel ("fiziksel kontroller geçse de bu makinede çalışmaz").
model MoldMachineProfile {
  id String @id @default(uuid())

  moldId String
  mold   Mold   @relation(fields: [moldId], references: [id], onDelete: Cascade)

  machineId String
  machine   ProductionMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  cycleTimeSec Float?
  setupMinutes Int?
  isPreferred  Boolean @default(false)
  isBlocked    Boolean @default(false)
  notes        String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([moldId, machineId])
  @@index([machineId])
}

/// Hammaddenin üretim bilgisi — katalog `Material`'ın 1:1 yan tablosu. Ayrı tutulur
/// çünkü `Material` public/portal yanıtlarında dönüyor; üretim alanları oraya
/// eklenseydi ya yanıtlara sızardı ya da her select ayrıca daraltılmak zorunda kalırdı.
/// Varyantın ÜRETİM bilgisi (katalog `ProductVariant`'ın 1:1 yan tablosu — hammadde profili deseni).
/// Yalnız iç üretim varyantlarına girilir; katalog kaydına dokunulmaz.
model ProductionVariantProfile {
  id String @id @default(uuid())

  variantId String         @unique
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// Varyanta özel çevrim (sn). Zincirde makine kartından SONRA, kalıp × hammadde katsayısından ÖNCE;
  /// hammadde katsayısıyla çarpılmaz (varyantın hammaddesi bellidir).
  cycleTimeSec Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MaterialProcessProfile {
  id String @id @default(uuid())

  materialId String   @unique
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  /// Makinede işlenen hammadde mi — metal burç/civata gibi insert'ler `false`.
  isMoldResin     Boolean @default(true)
  /// Hammadde ailesi: PP, PE, ABS, PA6, POM…
  family          String?
  densityGCm3     Float?
  requiresDrying  Boolean @default(false)
  dryingTempC     Int?
  dryingHours     Float?
  /// Kalıbın referans çevrimine çarpan (1 = etkisiz).
  cycleTimeFactor Float   @default(1)
  purgeNote       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Vardiya düzeni: makinenin günde kaç saat çalıştığını tanımlar (12 / 16 / 24 saat).
/// Günlük çalışma süresi, düzenin vardiyalarının toplamıdır.
model ShiftPattern {
  id        String  @id @default(uuid())
  name      String  @unique
  /// Makinede ve alanında düzen seçilmemişse geçerli olan. En fazla bir tane —
  /// kural uygulama katmanında.
  isDefault Boolean @default(false)
  timezone  String  @default("Europe/Istanbul")
  notes     String? @db.Text

  shifts   ShiftDefinition[]
  areas    ProductionArea[]
  machines ProductionMachine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Düzen içindeki bir vardiya. VARDİYA GÜNÜ, düzenin ilk vardiyasının (en küçük
/// `sortOrder`) başladığı gündür: saati ilk vardiyadan ÖNCE olan vardiya ertesi takvim
/// gününe düşer ama o vardiya gününe aittir (A 08:00, B 16:00, C 00:00 → C gece
/// devamı); `daysOfWeek` da vardiya gününe göredir. Vardiya gece yarısını geçebilir
/// (20:00 + 720 dk). Kurallar tek yerde: core/helpers/production/shiftPatterns.ts.
model ShiftDefinition {
  id String @id @default(uuid())

  patternId String
  pattern   ShiftPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  /// Lot ve raporlarda görünen kısa kod ("A", "B", "C").
  code            String
  name            String
  /// Gün başından dakika (480 = 08:00).
  startMinute     Int
  durationMinutes Int
  /// Çalışılan günler: 1 = Pazartesi … 7 = Pazar.
  daysOfWeek      Int[]
  sortOrder       Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([patternId, code])
  @@index([patternId, sortOrder])
}

enum ProductionCalendarExceptionKind {
  HOLIDAY
  SHUTDOWN
  EXTRA_WORKDAY
}

/// Takvim istisnası: bayram / toplu izin (çalışılmaz) ya da ek mesai günü.
/// Alan ve makine boşsa tüm fabrika için geçerlidir.
model ProductionCalendarException {
  id   String                          @id @default(uuid())
  date DateTime                        @db.Date
  kind ProductionCalendarExceptionKind
  note String?

  areaId String?
  area   ProductionArea? @relation(fields: [areaId], references: [id], onDelete: Cascade)

  machineId String?
  machine   ProductionMachine? @relation(fields: [machineId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

enum MachineDowntimeKind {
  PLANNED_MAINTENANCE
  BREAKDOWN
  OTHER
}

/// Makinenin kullanılamadığı pencere (planlı bakım, arıza). Planlama motoru bu
/// aralıkları makinenin çalışma pencerelerinden düşer.
model MachineDowntime {
  id String @id @default(uuid())

  machineId String
  machine   ProductionMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  kind    MachineDowntimeKind
  reason  String?             @db.Text

  createdByUserId String?
  createdByUser   User?   @relation("MachineDowntimeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId, startAt])
}

/// Makine başında çalışan personel. Giriş hesabı DEĞİL — bu aşamada operatörler
/// sisteme girmiyor, notları üretim planlayıcısı yazıyor (`CompanyContact`'ın
/// `User`'dan ayrı tutulmasıyla aynı desen). Hesap bağlama ayrı kararla eklenir.
model ProductionOperator {
  id         String  @id @default(uuid())
  firstName  String
  lastName   String
  employeeNo String? @unique
  phone      String?
  isActive   Boolean @default(true)
  notes      String? @db.Text

  /// Bağlı kaydı olan operatör silinmez (Restrict) — pasife alınır; silme ucu 409 döner.
  shiftAssignments MachineShiftAssignment[]
  lotOperators     ProductionLotOperator[]
  lotNotes         ProductionLotNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, lastName])
}

///////////////////////////////////////////////////////
// ÜRETİM PLANLAMA — EMİRLER (Faz 2)
// docs/production-planning.md §5.2. İş (ProductionJob) ve lotlar Dilim 2.3'te.
///////////////////////////////////////////////////////

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ProductionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ProductionOrderSource {
  MANUAL
  STOCK
  CUSTOMER_ORDER
}

/// Üretim emri: hangi varyanttan kaç SAĞLAM adet, hangi termine kadar. Yalnız kalıbı olan
/// ölçülerin varyantı için açılır (kural uygulama katmanında).
model ProductionOrder {
  id          String @id @default(uuid())
  /// Otomatik artan emir numarası — ekranda "UE-1001" (başlangıç migration'da 1001).
  orderNumber Int    @unique @default(autoincrement())

  /// Katalog varyantı. SetNull (müşteri siparişi kalemi gibi): varyant silinse de emir kaydı
  /// kalır; kod aşağıda kopyalı. Varyantı olmayan emir planlanmaz.
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  /// Oluşturma anındaki varyant kodu ("10.5.8.V1").
  variantCode      String

  /// Hedef SAĞLAM adet.
  quantity Int
  /// Termin günü (fabrika takvimi).
  dueDate  DateTime?             @db.Date
  priority ProductionPriority    @default(NORMAL)
  source   ProductionOrderSource @default(MANUAL)

  customerId String?
  customer   Customer? @relation("CustomerProductionOrders", fields: [customerId], references: [id], onDelete: SetNull)

  /// Elle çevrim (sn) — kalıp/makine kartı ve hammadde katsayısının önüne geçer (§6 zincir 1).
  cycleTimeOverrideSec Float?

  status ProductionOrderStatus @default(DRAFT)
  notes  String?               @db.Text

  createdByUserId String?
  createdByUser   User?   @relation("ProductionOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  jobOutputs ProductionJobOutput[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueDate])
  @@index([productVariantId])
  @@index([customerId])
}

///////////////////////////////////////////////////////
// ÜRETİM PLANLAMA — İŞLER VE LOTLAR (Faz 2, Dilim 2.3)
// docs/production-planning.md §5.2. İş = bir makine + bir kalıp + kesintisiz üretim
// (tahtadaki çubuk); lot = işin bir vardiyaya düşen dilimi ("1000-2").
///////////////////////////////////////////////////////

enum ProductionJobStatus {
  PLANNED
  RELEASED
  SETUP
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductionLotStatus {
  PLANNED
  RUNNING
  COMPLETED
  CANCELLED
}

model ProductionJob {
  id            String @id @default(uuid())
  /// Lot kökü — id gibi otomatik artan (başlangıç migration'da 1000); lot no = "kök-sıra".
  lotBaseNumber Int    @unique @default(autoincrement())

  machineId String
  machine   ProductionMachine @relation(fields: [machineId], references: [id], onDelete: Restrict)
  moldId    String
  mold      Mold              @relation(fields: [moldId], references: [id], onDelete: Restrict)

  /// Baskının ayarı: tüm gözler aynı renk + hammaddeyle dolar (VariantVersion.signature biçimi).
  versionSignature String

  plannedShots      Int
  setupStartAt      DateTime
  productionStartAt DateTime
  plannedEndAt      DateTime

  /// Planlama anı kopyaları — sözlük sonradan değişse de plan açıklanabilir kalır.
  cycleTimeSec      Float
  efficiencyPercent Int
  setupMinutes      Int

  status ProductionJobStatus @default(PLANNED)
  /// İyimser eşzamanlılık (tahtada iki planlayıcı) — Faz 3.
  version Int     @default(0)
  notes   String? @db.Text

  createdByUserId String?
  createdByUser   User?   @relation("ProductionJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  outputs       ProductionJobOutput[]
  lots          ProductionLot[]
  /// Durum geçmişi (Dilim 4.2) — pano geçişleri, planlama ve lot başlatma yazar.
  statusChanges ProductionJobStatusChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId, setupStartAt])
  @@index([moldId, setupStartAt])
  @@index([status])
}

/// İşin bir göz grubundan çıktısı. Aile kalıbında emri olmayan çıktı yan üründür (stok).
model ProductionJobOutput {
  id String @id @default(uuid())

  jobId String
  job   ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  moldOutputId String
  moldOutput   MoldOutput @relation(fields: [moldOutputId], references: [id], onDelete: Restrict)

  /// Kopya — istatistik sorguları join'siz; ölçü silinse de kayıt okunur.
  productSizeId     String
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)

  cavities        Int
  plannedQuantity Int
  goodQuantity    Int @default(0)
  scrapQuantity   Int @default(0)

  lotOutputs ProductionLotOutput[]

  @@unique([jobId, moldOutputId])
  @@index([productionOrderId])
  @@index([productSizeId])
}

/// İşin vardiyaya düşen dilimi. Numara saklanmaz: "kök-sıra" (`lotBaseNumber`-`sequence`).
model ProductionLot {
  id String @id @default(uuid())

  jobId    String
  job      ProductionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sequence Int

  /// Vardiya GÜNÜ (ilk vardiyanın günü; gece vardiyası ona ait).
  shiftDate DateTime @db.Date
  shiftCode String

  plannedStartAt DateTime
  plannedEndAt   DateTime
  plannedShots   Int
  actualStartAt  DateTime?
  actualEndAt    DateTime?

  status ProductionLotStatus @default(PLANNED)

  /// Vardiya raporu (Dilim 4.2): baskı (sayaç farkı ya da adetlerden), raporu kim / ne zaman girdi.
  /// Lot tamamlanmış ama `reportedAt` boşsa iş tamamlanırken raporsuz kapanmıştır (izlenmemiş).
  actualShots      Int?
  reportedAt       DateTime?
  reportedByUserId String?
  reportedByUser   User?     @relation("ProductionLotReportedBy", fields: [reportedByUserId], references: [id], onDelete: SetNull)

  outputs   ProductionLotOutput[]
  stops     ProductionStop[]
  /// Lota özel ekip ya da iş tamamlanırken vardiya ekibinden dondurulan kopya. Satır yoksa
  /// lotun ekibi vardiya ekibinden (makine × gün × vardiya) türetilir.
  operators ProductionLotOperator[]
  notes     ProductionLotNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, sequence])
  @@index([shiftDate, shiftCode])
}

model ProductionLotOutput {
  id String @id @default(uuid())

  lotId       String
  lot         ProductionLot       @relation(fields: [lotId], references: [id], onDelete: Cascade)
  jobOutputId String
  jobOutput   ProductionJobOutput @relation(fields: [jobOutputId], references: [id], onDelete: Cascade)

  plannedQuantity Int
  goodQuantity    Int @default(0)
  scrapQuantity   Int @default(0)

  /// Fire kırılımı (neden başına); toplamı `scrapQuantity`'yi aşamaz, kalan "belirtilmemiş".
  scraps ProductionLotScrap[]

  @@unique([lotId, jobOutputId])
}

/// Vardiya ekibi: hangi operatör hangi gün, hangi vardiyada, hangi makinede. Atama işe değil
/// makine × vardiya hücresine yapılır; o vardiyada o makinede üretilen lot ekibini buradan alır
/// (iş taşınınca atama kendiliğinden doğru kalır). Bir operatör aynı vardiyada birden çok
/// makineye bakabilir.
model MachineShiftAssignment {
  id String @id @default(uuid())

  machineId String
  machine   ProductionMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  /// Vardiya GÜNÜ (ilk vardiyanın günü; gece vardiyası ona ait) — lotla aynı anlam.
  shiftDate DateTime @db.Date
  shiftCode String

  operatorId String
  operator   ProductionOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([machineId, shiftDate, shiftCode, operatorId])
  @@index([shiftDate, shiftCode])
  @@index([operatorId, shiftDate])
}

/// Lotu üreten operatörler (istatistik için kopya ya da lota özel düzeltme).
model ProductionLotOperator {
  id String @id @default(uuid())

  lotId      String
  lot        ProductionLot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  operatorId String
  operator   ProductionOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([lotId, operatorId])
  @@index([operatorId])
}

enum ProductionLotNoteCategory {
  GENERAL
  QUALITY
  MAINTENANCE
  MATERIAL
  HANDOVER
}

/// Lot notu — planlayıcı yazar; operatör hesabı olmadığı için not bir operatör adına
/// girilebilir (`operatorId`).
model ProductionLotNote {
  id String @id @default(uuid())

  lotId    String
  lot      ProductionLot             @relation(fields: [lotId], references: [id], onDelete: Cascade)
  category ProductionLotNoteCategory @default(GENERAL)
  body     String                    @db.Text

  authorUserId String?
  authorUser   User?               @relation("ProductionLotNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  operatorId   String?
  operator     ProductionOperator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId, createdAt])
  @@index([operatorId])
}

enum ProductionReasonKind {
  STOP
  SCRAP
}

enum ProductionStopCategory {
  PLANNED
  BREAKDOWN
  MATERIAL
  QUALITY
  PERSONNEL
  OTHER
}

/// Duruş ve fire nedeni sözlüğü (Dilim 4.2). Kullanılan neden silinmez (Restrict), pasife alınır.
model ProductionReason {
  id           String                  @id @default(uuid())
  kind         ProductionReasonKind
  code         String
  name         String
  /// Yalnız duruş nedenlerinde (planlı / arıza / malzeme …) — kural uygulama katmanında.
  stopCategory ProductionStopCategory?
  isActive     Boolean                 @default(true)
  sortOrder    Int                     @default(0)

  stops  ProductionStop[]
  scraps ProductionLotScrap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, code])
  @@index([kind, isActive, sortOrder])
}

/// Lotta gerçekleşen duruş (vardiya raporu). Planlama pencereleri `MachineDowntime`'dadır.
model ProductionStop {
  id String @id @default(uuid())

  lotId           String
  lot             ProductionLot    @relation(fields: [lotId], references: [id], onDelete: Cascade)
  reasonId        String
  reason          ProductionReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  durationMinutes Int
  /// Biliniyorsa duruşun başladığı an (UTC; fabrika saatiyle girilir).
  startAt         DateTime?
  note            String?          @db.Text

  createdByUserId String?
  createdByUser   User?   @relation("ProductionStopCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lotId])
  @@index([reasonId])
}

/// Lot çıktısının fire kırılımı — neden başına adet.
model ProductionLotScrap {
  id String @id @default(uuid())

  lotOutputId String
  lotOutput   ProductionLotOutput @relation(fields: [lotOutputId], references: [id], onDelete: Cascade)
  reasonId    String
  reason      ProductionReason    @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  quantity    Int

  @@unique([lotOutputId, reasonId])
  @@index([reasonId])
}

/// İş durum geçmişi: kim, ne zaman, hangi durumdan hangisine (`fromStatus` boş = iş oluştu).
model ProductionJobStatusChange {
  id String @id @default(uuid())

  jobId      String
  job        ProductionJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus ProductionJobStatus?
  toStatus   ProductionJobStatus
  occurredAt DateTime             @default(now())

  userId String?
  user   User?   @relation("ProductionJobStatusChangeUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([jobId, occurredAt])
  @@index([toStatus, occurredAt])
}
