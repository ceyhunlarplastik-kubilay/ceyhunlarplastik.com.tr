  phone                    String?
  email                    String?
  countryId                Int?
  stateId                  Int?
  cityId                   Int?
  country                  String                           @default("Turkiye")
  city                     String
  district                 String?
  line1                    String
  line2                    String?
  postalCode               String?
  taxOffice                String?
  taxNumber                String?
  latitude                 Decimal?                         @db.Decimal(10, 8)
  longitude                Decimal?                         @db.Decimal(11, 8)
  locationSource           CustomerAddressLocationSource?
