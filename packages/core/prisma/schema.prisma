  title       String
  note        String?             @db.Text
  completedAt DateTime?

  createdByUserId String
  createdByUser   User   @relation("CustomerVisitCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

