model ProductVariantSupplier {
  id String @id @default(uuid())

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  /// Ürün modeli içindeki tedarikçi harfi ("A") — ProductSupplierCode'dan yazılan
  /// snapshot. Aramanın ve gösterimin join'siz çalışması için burada da tutulur.
  supplierCode String?
  /// Tedarikçili TAM kod: "10.5.8.V1.A".
  fullCode     String? @unique

  isActive Boolean @default(false)

  // ── Fiyat zinciri ────────────────────────────────────────────────────────────
  // DİKKAT: `price` TEDARİKÇİNİN BİZE fiyatıdır (alış) — operatörün "liste fiyatı"
  // dediği alan budur. `listPrice` ise BİZİM MÜŞTERİYE liste fiyatımızdır ve
  // netCost × (1 + profitRate) ile türetilir (bkz. helpers/pricing/productVariantSupplier.ts).
  price                 Decimal   @default(0) @db.Decimal(10, 2)
  operationalCostRate   Decimal?  @db.Decimal(5, 2)
  netCost               Decimal?  @db.Decimal(10, 2)
  profitRate            Decimal?  @db.Decimal(5, 2)
  listPrice             Decimal?  @db.Decimal(10, 2)
  paymentTermDays       Int?
  /// Tedarikçinin kendi ürün kodu — "AS231".
  supplierVariantCode   String?
  supplierNote          String?   @db.Text
  pricingUpdatedAt      DateTime?
  minOrderQty           Int?
  stockQty              Int?
  availabilityUpdatedAt DateTime?
  currency              String    @default("TRY")

  // ── Tedarikçiye özel ürün/lojistik bilgisi ───────────────────────────────────
  /// Ürünün üzerinde tedarikçinin kendi logosu var mı.
  hasSupplierLogo Boolean  @default(false)
  /// Bir kolide/pakette kaç adet.
  unitsPerPackage Int?
  packageLengthMm Decimal? @db.Decimal(10, 2)
  packageWidthMm  Decimal? @db.Decimal(10, 2)
  packageHeightMm Decimal? @db.Decimal(10, 2)
  packageWeightKg Decimal? @db.Decimal(10, 3)
  /// Minimum termin süresi (gün).
  minLeadTimeDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, supplierId])
  @@index([variantId])
  @@index([supplierId])
  @@index([supplierCode])
}

///////////////////////////////////////////////////////
// PRODUCT VARIANT CAMPAIGN
///////////////////////////////////////////////////////

/// Kampanya, MÜŞTERİYE ÖZEL DEĞİLDİR: tüm müşterilere aynı yüzde indirimi açar.
/// Müşteriye özel pazarlık (CustomerVariantSpecialPrice) her koşulda kampanyayı
/// ezer; kampanya ile genel iskonto ise ikisi de liste fiyatına yüzde olduğu için
/// karşılaştırılır ve büyük olan uygulanır (bkz. customerPricing.ts).
model ProductVariantCampaign {
  id String @id @default(uuid())

  title       String
  description String? @db.Text

  /// Kampanya geneli indirim; kalem bazında ezilebilir.
  discountPercent Decimal @db.Decimal(5, 2)

  validFrom  DateTime?
  validUntil DateTime?

  status ProductVariantCampaignStatus @default(DRAFT)

  createdByUserId String
  createdByUser   User   @relation("ProductVariantCampaignCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  items         ProductVariantCampaignItem[]
  announcements CampaignAnnouncement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, validFrom, validUntil])
  @@index([createdByUserId])
}

model ProductVariantCampaignItem {
  id String @id @default(uuid())

  campaignId String
  campaign   ProductVariantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  /// Doluysa kampanya genelindeki oranın yerine geçer.
  discountPercent Decimal? @db.Decimal(5, 2)

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, productVariantId])
  @@index([productVariantId])
  @@index([campaignId, displayOrder])
}

enum ProductVariantCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Kampanya duyurusu: satış temsilcisinin seçtiği müşterilere sıcak temas listesi.
/// Kampanya oluşturulduğunda OTOMATİK bildirim gitmez — temsilci bilinçli olarak
/// müşteri seçer ki gerçek geri dönüşler takip edilebilsin.
model CampaignAnnouncement {
  id String @id @default(uuid())

  campaignId String
  campaign   ProductVariantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  /// Duyuruyu oluşturan satış temsilcisi.
  createdByUserId String
  createdByUser   User   @relation("CampaignAnnouncementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Duyuru geneli not (kampanya mesajının özeti, hedef vb.).
  note String? @db.Text

  recipients CampaignAnnouncementRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId, createdAt])
  @@index([createdByUserId, createdAt])
}

model CampaignAnnouncementRecipient {
  id String @id @default(uuid())

  announcementId String
  announcement   CampaignAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Kanal alıcı bazındadır: bir müşteri aranır, diğerine mail atılır.
  channel CampaignAnnouncementChannel

  status CampaignAnnouncementRecipientStatus @default(PENDING)

  /// Görüşme notu — temsilcinin o müşteriyle teması hakkında yazdığı.
  note String? @db.Text

  contactedAt DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([announcementId, customerId])
  @@index([customerId, createdAt])
  @@index([announcementId, status])
}

enum CampaignAnnouncementChannel {
  /// Temsilci kendi telefonundan aradı/yazdı; sistem yalnız kaydı tutar.
  MANUAL
  EMAIL
  WHATSAPP
}

enum CampaignAnnouncementRecipientStatus {
  PENDING
  REACHED
  RESPONDED
  NOT_INTERESTED
  UNREACHABLE
}

model CustomerVariantSpecialPrice {
