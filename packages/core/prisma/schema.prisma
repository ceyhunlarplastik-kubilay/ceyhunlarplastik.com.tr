  paymentTermNote       String?   @db.Text
  commercialNote        String?   @db.Text
  negotiationNote       String?   @db.Text
  approvedFromRequestAt DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([requestedByUserId, createdAt])
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  quantity          Int      @default(1)
  listUnitPrice     Decimal? @db.Decimal(12, 2)
  customerUnitPrice Decimal? @db.Decimal(12, 2)
  listLineTotal     Decimal? @db.Decimal(12, 2)
  customerLineTotal Decimal? @db.Decimal(12, 2)
  currency          String   @default("TRY")
  note              String?  @db.Text
  data              Json?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, displayOrder])
  @@index([productVariantId])
}

model BusinessRequestItem {
  id String @id @default(uuid())

  requestId String
  request   BusinessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)

  quantity Int     @default(1)
  note     String? @db.Text
  data     Json?

  displayOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId, displayOrder])
  @@index([productVariantId])
}

model BusinessRequestApprovalStep {
  id String @id @default(cuid())

  requestId String
  request   BusinessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  stepOrder    Int
  requiredRole ApprovalRole

  assignedUserId String?
  assignedUser   User?   @relation("BusinessRequestStepAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)

  status ApprovalStepStatus @default(PENDING)

  decidedByUserId String?
  decidedByUser   User?     @relation("BusinessRequestStepDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decidedAt       DateTime?
  decisionNote    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requestId, stepOrder])
  @@index([assignedUserId, status, createdAt])
  @@index([requiredRole, status, createdAt])
  @@index([decidedByUserId, createdAt])
}

model ActivityLog {
  id String @id @default(cuid())

  requestId String?
  request   BusinessRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  actorUserId String?
  actorUser   User?   @relation("ActivityLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  source      String
  eventType   String
  title       String
  description String? @db.Text
  data        Json?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

model Material {
  id String @id @default(uuid())

  name String
  code String? // PP, PE, PVC gibi

  // bkz. Color.versions — hammadde de versiyon kaydına bağlanır.
  versions     VariantVersion[]
  assets       Asset[]
  translations MaterialTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
}

model MaterialTranslation {
  id         String @id @default(uuid())
  materialId String
  locale     String @db.VarChar(16)
  name       String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([materialId, locale])
  @@index([locale, materialId])
}

enum AssetType {
  IMAGE
  VIDEO
  PDF
  TECHNICAL_DRAWING
  CERTIFICATE
}

// ASSEMBLY_VIDEO kaldırıldı: montaj videosu artık S3 asset'i değil,
// Product.assemblyVideoUrl üzerinde tutulan bir YouTube linki.
enum AssetRole {
  PRIMARY
  ANIMATION
  GALLERY
  DOCUMENT
  TECHNICAL_DRAWING
  MODEL_3D
  CERTIFICATE
}

// kaldırıldı
// isPrimary Boolean   @default(false)
model Asset {
  id String @id @default(uuid())

  key           String // S3 key
  mimeType      String // image/png, image/gif, application/pdf
  type          AssetType
  role          AssetRole
  model3dConfig Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  productAttributeValueId String?
  productAttributeValue   ProductAttributeValue? @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)

  materialId String?
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([productId])
  @@index([variantId])
  @@index([productAttributeValueId])
  @@index([materialId])
}
