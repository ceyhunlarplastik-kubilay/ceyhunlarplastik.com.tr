// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

///////////////////////////////////////////////////////
// USER
///////////////////////////////////////////////////////

model User {
  id                              String                        @id @default(uuid())
  cognitoSub                      String                        @unique
  email                           String                        @unique
  identifier                      String
  firstName                       String?
  lastName                        String?
  imageKey                        String?
  phone                           String?
  groups                          String[]
  accessStatus                    UserAccessStatus              @default(PENDING_REVIEW)
  accessStatusChangedAt           DateTime?
  accessStatusChangedByUserId     String?
  accessStatusReason              String?                       @db.Text
  supplierId                      String?
  supplier                        Supplier?                     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customerId                      String?
  customer                        Customer?                     @relation("CustomerPortalUsers", fields: [customerId], references: [id], onDelete: SetNull)
  customerContactTitle            String?
  customerContactDepartment       String?
  isPrimaryCustomerContact        Boolean                       @default(false)
  isActive                        Boolean                       @default(true)
  assignedSalesCustomers          Customer[]                    @relation("AssignedSalesUser")
  convertedCustomers              Customer[]                    @relation("CustomerConvertedBy")
  assignedPurchasingSuppliers     Supplier[]                    @relation("SupplierPurchasingAssignments")
  requestedBusinessRequests       BusinessRequest[]             @relation("BusinessRequestRequestedBy")
  requestedOrders                 Order[]                       @relation("CustomerOrderRequestedBy")
  assignedBusinessRequestSteps    BusinessRequestApprovalStep[] @relation("BusinessRequestStepAssignedUser")
  decidedBusinessRequestSteps     BusinessRequestApprovalStep[] @relation("BusinessRequestStepDecidedBy")
  activityLogs                    ActivityLog[]                 @relation("ActivityLogActor")
  createdCustomerFeaturedProducts CustomerFeaturedProduct[]     @relation("CustomerFeaturedProductCreatedBy")
  createdCustomerAssignedProducts CustomerAssignedProduct[]     @relation("CustomerAssignedProductCreatedBy")
  createdProductVariantCampaigns  ProductVariantCampaign[]      @relation("ProductVariantCampaignCreatedBy")
  createdCampaignAnnouncements    CampaignAnnouncement[]        @relation("CampaignAnnouncementCreatedBy")
  ownedCustomerVisits             CustomerVisit[]               @relation("CustomerVisitOwner")
  createdCustomerVisits           CustomerVisit[]               @relation("CustomerVisitCreatedBy")
  createdCustomerSpecialPrices    CustomerVariantSpecialPrice[] @relation("CustomerVariantSpecialPriceCreatedBy")
  approvedCustomerSpecialPrices   CustomerVariantSpecialPrice[] @relation("CustomerVariantSpecialPriceApprovedBy")
  notifications                   UserNotification[]
  verifiedCustomerAddresses       CustomerAddress[]             @relation("CustomerAddressVerifiedByUser")
  customerInvitations             UserInvitation[]              @relation("CustomerPortalInvitationUser")
  sentCustomerInvitations         UserInvitation[]              @relation("CustomerPortalInvitationInvitedByUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([customerId, isPrimaryCustomerContact])
  @@index([accessStatus, createdAt])
}

enum UserAccessStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

model UserNotification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      UserNotificationType
  title     String
  message   String               @db.Text
  data      Json?
  readAt    DateTime?
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
}

enum UserNotificationType {
  ACCESS_STATUS_CHANGED
  ROLE_CHANGED
  ASSIGNMENT_CHANGED
  REQUEST_CREATED
  APPROVAL_REQUIRED
  REQUEST_DECIDED
}

///////////////////////////////////////////////////////
// COLOR
///////////////////////////////////////////////////////

model Color {
  id       String      @id @default(uuid())
  system   ColorSystem @default(RAL)
  code     String
  name     String
  hex      String
  rgbR     Int?
  rgbG     Int?
  rgbB     Int?
  isActive Boolean     @default(true)

  // Renk varyanta doğrudan değil, ürün modeli başına tutulan versiyon kaydına
  // (renk + hammadde kombinasyonu = "V1") bağlanır.
  versions     VariantVersion[]
  translations ColorTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([system, code])
}

model ColorTranslation {
  id      String @id @default(uuid())
  colorId String
  locale  String @db.VarChar(16)
  name    String

  color Color @relation(fields: [colorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colorId, locale])
  @@index([locale, colorId])
}

enum ColorSystem {
  RAL
  PANTONE
  NCS
  CUSTOM
}

///////////////////////////////////////////////////////
// CATEGORY
///////////////////////////////////////////////////////

model Category {
  id                       String   @id @default(uuid())
  code                     Int
  name                     String
  slug                     String   @unique
  allowedAttributeValueIds String[] @default([])

  products     Product[]
  assets       Asset[]
  translations CategoryTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
}

model CategoryTranslation {
  id         String @id @default(uuid())
  categoryId String
  locale     String @db.VarChar(16)
  name       String
  slug       String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@index([locale, categoryId])
}

///////////////////////////////////////////////////////
// PRODUCT (10.11)
///////////////////////////////////////////////////////

model Product {
  id String @id @default(uuid())

  code String // 10.11
  name String
  slug String @unique

  description String? @db.Text

  // Ürün videoları YouTube'da barındırılır (S3 asset'i değil): kanonik watch URL'i
  // saklanır, gömme/thumbnail adresleri buradan türetilir.
  // bkz. core/helpers/products/youtubeVideo.ts
  assemblyVideoUrl String? // montaj videosu
  promoVideoUrl    String? // ürün tanıtım videosu

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  variants            ProductVariant[]
  // Varyant kod sisteminin ürün-modeli başına tutulan sözlükleri:
  // ölçü şablonu (hangi ölçüler zorunlu), ölçü kayıtları (kodun 3. segmenti),
  // versiyonlar (4. segment) ve tedarikçi harfleri (5. segment).
  measurementRequirements ProductMeasurementRequirement[]
  sizes                   ProductSize[]
  versions                VariantVersion[]
  supplierCodes           ProductSupplierCode[]
  assets              Asset[]
  attributeValues     ProductAttributeValue[]
  industrialUsages    ProductIndustrialUsage[]
  translations        ProductTranslation[]
  featuredByCustomers CustomerFeaturedProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code])
  @@index([categoryId])
}

model ProductTranslation {
  id          String  @id @default(uuid())
  productId   String
  locale      String  @db.VarChar(16)
  name        String
  slug        String
  description String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@index([locale, productId])
}

model ProductAttribute {
  id String @id @default(uuid())

  code String @unique // usage_area, model_type, connection_type, profile_type, material_type, usage_type, hat_type
  name String

  displayOrder         Int     @default(0)
  isActive             Boolean @default(true)
  isCustomerAssignable Boolean @default(false)

  values ProductAttributeValue[]
  translations ProductAttributeTranslation[]
  valueTranslations ProductAttributeValueTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductAttributeTranslation {
  id                 String @id @default(uuid())
  productAttributeId String
  locale             String @db.VarChar(16)
  name               String

  productAttribute ProductAttribute @relation(fields: [productAttributeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productAttributeId, locale])
  @@index([locale, productAttributeId])
}

model ProductAttributeValue {
  id String @id @default(uuid())

  name String
  slug String

  attributeId String
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  parentValueId String?
  parentValue   ProductAttributeValue?  @relation("AttributeValueHierarchy", fields: [parentValueId], references: [id], onDelete: SetNull)
  childValues   ProductAttributeValue[] @relation("AttributeValueHierarchy")

  // 🔥 MANY TO MANY
  products                          Product[]
  assets                            Asset[]
  translations                      ProductAttributeValueTranslation[]
  customerSectors                   Customer[]                         @relation("CustomerSector")
  customerProductionGroups          Customer[]                         @relation("CustomerProductionGroup")
  customerUsageAreas                Customer[]                         @relation("CustomerUsageAreas")
  customerAttributeAssignments      CustomerAttributeValueAssignment[]
  productIndustrialSectors          ProductIndustrialUsage[]           @relation("ProductIndustrialUsageSector")
  productIndustrialProductionGroups ProductIndustrialUsage[]           @relation("ProductIndustrialUsageProductionGroup")
  productIndustrialUsageAreas       ProductIndustrialUsage[]           @relation("ProductIndustrialUsageArea")

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, name])
  @@index([attributeId])
  @@index([parentValueId])
}

model ProductAttributeValueTranslation {
  id                      String @id @default(uuid())
  productAttributeValueId String
  attributeId             String
  locale                  String @db.VarChar(16)
  name                    String
  slug                    String

  productAttributeValue ProductAttributeValue @relation(fields: [productAttributeValueId], references: [id], onDelete: Cascade)
  attribute             ProductAttribute      @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productAttributeValueId, locale])
  @@unique([attributeId, locale, slug])
  @@index([locale, attributeId])
}

model ProductIndustrialUsage {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sectorValueId String?
  sectorValue   ProductAttributeValue? @relation("ProductIndustrialUsageSector", fields: [sectorValueId], references: [id], onDelete: SetNull)

  productionGroupValueId String?
  productionGroupValue   ProductAttributeValue? @relation("ProductIndustrialUsageProductionGroup", fields: [productionGroupValueId], references: [id], onDelete: SetNull)

  usageAreaValueId String?
  usageAreaValue   ProductAttributeValue? @relation("ProductIndustrialUsageArea", fields: [usageAreaValueId], references: [id], onDelete: SetNull)

  usageFunction String? @db.Text
  // Varsayılan (TR) görsel. Locale'e özgü görsel
  // ProductIndustrialUsageTranslation.imageKey'de tutulur; o yoksa buraya düşülür.
  imageKey      String?
  displayOrder  Int     @default(0)

  translations ProductIndustrialUsageTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, displayOrder])
  @@index([sectorValueId])
  @@index([productionGroupValueId])
  @@index([usageAreaValueId])
}

model ProductIndustrialUsageTranslation {
  id                       String  @id @default(uuid())
  productIndustrialUsageId String
  locale                   String  @db.VarChar(16)
  // Nullable: görselde yazı olduğu için yalnız görseli çevrilen (metni ortak
  // kalan) satırlar mümkün olmalı.
  usageFunction            String? @db.Text
  imageKey                 String?

  productIndustrialUsage ProductIndustrialUsage @relation(fields: [productIndustrialUsageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productIndustrialUsageId, locale])
  @@index([locale, productIndustrialUsageId])
}

model Customer {
  id String @id @default(uuid())

  /// Firma adı. Tekillik YOK: Türkiye'de aynı unvanla birden çok firma olabiliyor;
  /// ayrım vergi numarası, adres ve konumdan yapılır.
  companyName            String?
  /// Yetkili kişi adı. Veri girişi panelinde firma kaydedilirken boş bırakılabilir;
  /// public web formunda ise ZORUNLUDUR (orada kişi kendini kaydeder). Kısıt bu
  /// yüzden şemada değil, yüzeye özel validator'larda.
  fullName               String?
  phone                  String
  email                  String
  /// Firma web sitesi. Normalize edilerek saklanır ("acme.com" → "https://acme.com");
  /// kural core/helpers/crm/customerWebsite.ts içinde.
  websiteUrl             String?
  note                   String?        @db.Text
  status                 CustomerStatus @default(LEAD)
  generalDiscountPercent Decimal?       @db.Decimal(5, 2)
  defaultPaymentTermDays Int?
  creditLimit            Decimal?       @db.Decimal(12, 2)
  paymentTermNote        String?        @db.Text

  assignedSalesUserId String?
  assignedSalesUser   User?   @relation("AssignedSalesUser", fields: [assignedSalesUserId], references: [id], onDelete: SetNull)

  convertedAt       DateTime?
  convertedByUserId String?
  convertedByUser   User?     @relation("CustomerConvertedBy", fields: [convertedByUserId], references: [id], onDelete: SetNull)

  sectorValueId String?
  sectorValue   ProductAttributeValue? @relation("CustomerSector", fields: [sectorValueId], references: [id], onDelete: SetNull)

  productionGroupValueId String?
  productionGroupValue   ProductAttributeValue? @relation("CustomerProductionGroup", fields: [productionGroupValueId], references: [id], onDelete: SetNull)

  usageAreaValues           ProductAttributeValue[]            @relation("CustomerUsageAreas")
  attributeValueAssignments CustomerAttributeValueAssignment[]
  companyContactAssignments CustomerCompanyContactAssignment[]
  portalUsers               User[]                             @relation("CustomerPortalUsers")
  userInvitations           UserInvitation[]
  featuredProducts          CustomerFeaturedProduct[]
  assignedProducts          CustomerAssignedProduct[]
  addresses                 CustomerAddress[]
  visits                    CustomerVisit[]
  businessRequests          BusinessRequest[]
  orders                    Order[]
  specialVariantPrices      CustomerVariantSpecialPrice[]
  campaignAnnouncements     CampaignAnnouncementRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@index([assignedSalesUserId, status, createdAt])
  @@index([sectorValueId])
  @@index([productionGroupValueId])
}

model UserInvitation {
  id String @id @default(uuid())

  userId String
  user   User   @relation("CustomerPortalInvitationUser", fields: [userId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  invitedByUserId String
  invitedByUser   User   @relation("CustomerPortalInvitationInvitedByUser", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  email                              String
  tokenHash                          String    @unique
  expiresAt                          DateTime
  acceptedAt                         DateTime?
  requestedFirstName                 String?
  requestedLastName                  String?
  requestedCustomerContactTitle      String?
  requestedCustomerContactDepartment String?
  requestedIsPrimaryCustomerContact  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, expiresAt])
  @@index([userId])
}

model CustomerAttributeValueAssignment {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  source CustomerAttributeValueAssignmentSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, attributeValueId])
  @@index([customerId])
  @@index([attributeValueId])
}

model CompanyContact {
  id String @id @default(uuid())

  department    String
  name          String
  roleLabel     String?
  email         String?
  phone         String?
  whatsappPhone String?
  note          String? @db.Text
  isActive      Boolean @default(true)
  displayOrder  Int     @default(0)

  customerAssignments CustomerCompanyContactAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@index([department])
}

model CustomerCompanyContactAssignment {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  companyContactId String
  companyContact   CompanyContact @relation(fields: [companyContactId], references: [id], onDelete: Cascade)

  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  note         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, companyContactId])
  @@index([customerId, isActive, displayOrder])
  @@index([companyContactId])
}

model GeoCountry {
  id               Int      @id
  name             String
  iso3             String?
  iso2             String   @unique
  numericCode      String?  @map("numeric_code")
  phoneCode        String?  @map("phonecode")
  capital          String?
  currency         String?
  currencyName     String?  @map("currency_name")
  currencySymbol   String?  @map("currency_symbol")
  tld              String?
  native           String?
  population       BigInt?
  gdp              String?
  region           String?
  regionId         Int?     @map("region_id")
  subregion        String?
  subregionId      Int?     @map("subregion_id")
  nationality      String?
  areaSqKm         String?  @map("area_sq_km")
  postalCodeFormat String?  @map("postal_code_format")
  postalCodeRegex  String?  @map("postal_code_regex")
  timezones        Json?
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  emoji            String?
  emojiU           String?
  wikiDataId       String?

  states            GeoState[]
  cities            GeoCity[]
  customerAddresses CustomerAddress[]

  @@index([name])
  @@map("geo_countries")
}

model GeoState {
  id          Int      @id
  name        String
  countryId   Int      @map("country_id")
  countryCode String?  @map("country_code")
  countryName String?  @map("country_name")
  iso2        String?
  iso3166_2   String?
  fipsCode    String?  @map("fips_code")
  type        String?
  level       String?
  parentId    Int?     @map("parent_id")
  native      String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  timezone    String?
  wikiDataId  String?
  population  BigInt?

  country           GeoCountry        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cities            GeoCity[]
  customerAddresses CustomerAddress[]

  @@index([countryId, name])
  @@index([countryCode])
  @@map("geo_states")
}

model GeoCity {
  id           Int      @id
  name         String
  stateId      Int?     @map("state_id")
  stateCode    String?  @map("state_code")
  stateName    String?  @map("state_name")
  countryId    Int      @map("country_id")
  countryCode  String?  @map("country_code")
  countryName  String?  @map("country_name")
  latitude     Decimal? @db.Decimal(10, 8)
  longitude    Decimal? @db.Decimal(11, 8)
  native       String?
  type         String?
  level        String?
  parentId     Int?     @map("parent_id")
  population   BigInt?
  timezone     String?
  translations Json?
  wikiDataId   String?

  country           GeoCountry        @relation(fields: [countryId], references: [id], onDelete: Restrict)
  state             GeoState?         @relation(fields: [stateId], references: [id], onDelete: SetNull)
  customerAddresses CustomerAddress[]

  @@index([countryId, name])
  @@index([stateId, name])
  @@map("geo_cities")
}

enum CustomerStatus {
  LEAD
  CUSTOMER
}

enum CustomerAttributeValueAssignmentSource {
  MANUAL
  LEGACY_BACKFILL
  SYSTEM
}

model WebRequest {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  email   String
  phone   String?
  message String? @db.Text

  // B2B inquiry sepet snapshot (productId, variant info, quantity...)
  items Json

  status WebRequestStatus @default(NEW)

  @@index([email])
  @@index([status, createdAt])
}

enum WebRequestStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CLOSED
}

///////////////////////////////////////////////////////
// PRODUCT VARIANT (10.5.8.V1)
///////////////////////////////////////////////////////

/// Varyant = ürün modeli + ÖLÇÜ + VERSİYON (renk & hammadde). Tedarikçi varyantın
/// bir parçası DEĞİLDİR: aynı fiziksel ürünü birden çok tedarikçiden alabiliriz ve
/// her tedarikçinin kendi kodu/fiyatı/koli bilgisi `ProductVariantSupplier`
/// üzerinde yaşar. Tedarikçili tam kod (`10.5.8.V1.A`) da oradadır.
///
/// Kod üretimi tek kaynaktan gelir:
/// `core/helpers/productVariants/variantCode.ts` + `assignProductVariantCodes.ts`.
model ProductVariant {
  id String @id @default(uuid())

  name      String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  /// Kodun 3. segmenti buradan gelir (ProductSize.code).
  productSizeId String
  size          ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Restrict)

  /// Kodun 4. segmenti buradan gelir (VariantVersion.code → "V1").
  /// Versiyon ÜRÜN MODELİ BAŞINA tanımlıdır ve önceden tanımlanmış olmalıdır.
  variantVersionId String
  version          VariantVersion @relation(fields: [variantVersionId], references: [id], onDelete: Restrict)

  /// "10.5.8.V1" — tedarikçi harfi İÇERMEZ.
  fullCode String @unique

  assets Asset[]

  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  variantSuppliers      ProductVariantSupplier[]
  assignedToCustomers   CustomerAssignedProduct[]
  requestItems          BusinessRequestItem[]
  orderItems            OrderItem[]
  customerSpecialPrices CustomerVariantSpecialPrice[]
  campaignItems         ProductVariantCampaignItem[]

  @@unique([productId, productSizeId, variantVersionId])
  @@index([productId])
  @@index([productSizeId])
  @@index([variantVersionId])
}

/// Ürün modeline özel ölçü şablonu: bu modelde HANGİ ölçülerin girilmesi gerektiği.
/// `Category.allowedAttributeValueIds`'in ürün-modeli karşılığıdır, ama düz bir id
/// listesi değil ilişki tablosudur — çünkü ölçü başına etiket, birim ve sıralama
/// önceliği taşımamız gerekir: "1.1" modelinde `R` = "Elcik Çapı", "1.8" modelinde
/// aynı `R` = "Kol Çapı".
model ProductMeasurementRequirement {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  measurementTypeId String
  measurementType   MeasurementType @relation(fields: [measurementTypeId], references: [id], onDelete: Restrict)

  /// Ürün modeline özel görünen ad — "Kol Çapı", "Burç Metriği".
  label String
  /// null → MeasurementType.baseUnit. Şablon cm/mm farkını burada ezebilir.
  unit  String?

  isRequired Boolean @default(true)
  /// Ölçü KODU sıralamasında anahtar önceliği (küçük olan baskın).
  sortPriority Int @default(0)
  /// Tablo kolon sırası.
  displayOrder Int @default(0)

  translations ProductMeasurementRequirementTranslation[]
  sizeValues   ProductSizeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, measurementTypeId, label])
  @@index([productId, displayOrder])
  @@index([measurementTypeId])
}

model ProductMeasurementRequirementTranslation {
  id            String @id @default(uuid())
  requirementId String
  locale        String @db.VarChar(16)
  label         String

  requirement ProductMeasurementRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([requirementId, locale])
  @@index([locale, requirementId])
}

/// Ürün modeli içindeki bir ÖLÇÜ — kodun 3. segmenti.
///
/// `signature` tekilleştirme anahtarıdır: aynı fiziksel ölçü kaç farklı tedarikçi
/// kataloğundan girilirse girilsin TEK kod alır (eski `variantIndex` elle girildiği
/// için bunu sağlayamıyordu). `sortKey` ise "küçükten büyüğe" numaralandırmayı
/// besler; çok ölçülü modellerde (ör. "M4 + 10 cm") şablondaki `sortPriority`
/// sırasına göre çok anahtarlıdır. İkisi de
/// `core/helpers/productVariants/sizeSignature.ts` tarafından üretilir.
model ProductSize {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 1..N. Taslakta yeniden numaralanır, kilitten sonra append-only.
  code      Int
  signature String
  sortKey   String

  values   ProductSizeValue[]
  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // `signature` ARTIK TEKİL DEĞİL: aynı fiziksel ölçü farklı tedarikçilerden
  // girildiğinde her giriş kendi kodunu alır (4.1.1 Özgen, 4.1.7 Esersan) —
  // kod, veri girişi sırasının sayacıdır. Tekilleştirme "ölçü + tedarikçi"
  // anahtarıyla UYGULAMA katmanında yapılır (bkz. productVariantWriter), çünkü
  // tedarikçi `ProductSize` üzerinde değil `ProductVariantSupplier` üzerinde.
  // Public/portal listeleri ölçüleri zaten gruplayıp tekilleştiriyor.
  @@unique([productId, code])
  @@index([productId, sortKey])
}

model ProductSizeValue {
  id String @id @default(uuid())

  productSizeId String
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  /// Şablonda tanımlı olmayan ölçü girilemesin diye doğrudan gereksinime bağlanır;
  /// Restrict, kullanımdaki bir gereksinimin sessizce silinmesini de engeller.
  requirementId String
  requirement   ProductMeasurementRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  value Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productSizeId, requirementId])
  @@index([requirementId])
}

/// Ürün modeli içindeki RENK + HAMMADDE kombinasyonu — kodun 4. segmenti ("V1").
/// Ölçüden farklı olarak doğal bir büyüklük sırası yoktur: ilk atamada derli toplu
/// ve deterministik sıralanır, sonrasında append-only'dur.
/// Renk + hammadde kombinasyonu — kodun 4. segmenti ("V1"). **ÜRÜN MODELİ BAŞINA.**
///
/// Her ürün modelinin kendi V listesi vardır: "10.5" içinde Siyah+Bakalit V1
/// olabilirken "10.8" içinde aynı kombinasyon başka bir numara taşıyabilir. Ölçü
/// koduyla aynı mantık — `10.5.1` ile `10.8.1` de farklı ölçülerdir.
///
/// Numara APPEND-ONLY'dur ve ASLA yeniden sıralanmaz. Asıl hata ürün başına olması
/// DEĞİL, her kayıtta renk koduna göre 1..N yeniden numaralandırılmasıydı: bir ürüne
/// yeni renk eklemek o üründeki tüm versiyon kodlarını kaydırıyor, dışarı çıkmış
/// kodları (katalog, teklif, tedarikçi siparişi) yanlış varyanta işaret eder hâle
/// getiriyordu. Ölçünün aksine versiyonun sıralanması için bir iş kuralı yok.
///
/// ÖNCE TANIMLANMALI: varyant girişi sırasında bilinmeyen bir kombinasyon
/// OTOMATİK EKLENMEZ, reddedilir (bkz. productVariantWriter). Kod ataması bilinçli
/// bir karar olmalı.
model VariantVersion {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// 1 → "V1". Ürün modeli içinde tekil.
  code Int

  colorId String?
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: Restrict)

  /// Hammadde ÇOKLUDUR.
  materials Material[]

  /// "color:<id>|materials:<id>,<id>" — aynı kombinasyon bir üründe iki kez tanımlanamaz.
  signature String

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, code])
  @@unique([productId, signature])
  @@index([productId, code])
  @@index([colorId])
}

/// Ürün modeli içinde tedarikçiye verilen harf — kodun 5. segmenti ("A").
/// Kilit durumundan BAĞIMSIZ olarak her zaman append-only'dur: verilmiş bir harf
/// asla başka tedarikçiye devredilmez, aradan çıkan tedarikçinin boşluğu doldurulmaz.
model ProductSupplierCode {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  code String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, supplierId])
  @@unique([productId, code])
  @@index([supplierId])
}

///////////////////////////////////////////////////////
// MEASUREMENT TYPE
///////////////////////////////////////////////////////

enum MeasurementCode {
  D // Diameter (Çap) / Metrik (D)
  D1 // Metrik (D1)
  D2 // Metrik (D2)
  R // Radius (R) / Çap (R)
  R1 // Çap (R1)
  R2 // Çap (R2)
  L // Length (Uzunluk)
  L1 // Uzunluk (L1)
  L2 // Uzunluk (L2)
  T // Thickness (Kalınlık)
  A // Angle (Açı)
  W // Width (Genişlik)
  H // Height (Yükseklik) / Ürün Yüksekliği
  H1 // Ürün Yüksekliği (H1)
  H2 // Civata Uzunluğu (H2)
  PT // Profile Thickness (Profil Kalınlığı)
  M // Metric thread size (M8, M6...)
  R_L // R-L
}

model MeasurementType {
  id           String          @id @default(uuid())
  name         String
  code         MeasurementCode @unique
  baseUnit     String // mm, degree, kg
  displayOrder Int             @default(0)

  // Ölçüler artık varyanta doğrudan değil, ürün modelinin ölçü şablonuna ve
  // oradan ProductSizeValue'ya bağlanır.
  requirements  ProductMeasurementRequirement[]
  translations  MeasurementTypeTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MeasurementTypeTranslation {
  id                String @id @default(uuid())
  measurementTypeId String
  locale            String @db.VarChar(16)
  name              String

  measurementType MeasurementType @relation(fields: [measurementTypeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([measurementTypeId, locale])
  @@index([locale, measurementTypeId])
}

// ProductMeasurement kaldırıldı: ölçüler artık varyant başına DEĞİL, ürün modeli
// başına tekilleştirilmiş ProductSize/ProductSizeValue üzerinde tutuluyor. Aksi
// hâlde aynı fiziksel ölçü her tedarikçi satırında tekrar edip kod tekilliğini
